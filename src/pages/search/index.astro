---
import WpLayout from '../../layouts/WpLayout.astro';import {API} from '../../lib/cars24';
---
<WpLayout title="Пошук — Cars24"><main class="c24-zero-page"><div class="c24-shell"><header class="c24-search-results-head"><span class="c24-zero-kicker">ПОШУК CARS24</span><h1 data-search-title>Пошук</h1><form data-search-form><input name="q" placeholder="VIN, марка, модель, стаття..."/><button>Знайти</button></form></header><div class="c24-search-results-layout"><section class="c24-search-results-list" data-search-list><div class="c24-zero-empty"><p>Введіть VIN, марку або модель.</p></div></section><aside class="c24-search-help"><span>CARS24</span><h3>Не знайшли?</h3><p>Напишіть нам VIN або модель.</p><a href="https://t.me/Egor_Cars24">Написати</a></aside></div></div></main><script is:inline define:vars={{API,base:import.meta.env.BASE_URL}}>document.addEventListener('DOMContentLoaded',()=>{const form=document.querySelector('[data-search-form]'),input=form.querySelector('input'),title=document.querySelector('[data-search-title]'),list=document.querySelector('[data-search-list]');const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));const slug=s=>String(s||'').toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');async function run(q,push=false){q=(q||'').trim();input.value=q;title.textContent=q?'Результати: '+q:'Пошук';if(push){const x=new URL(location.href);q?x.searchParams.set('q',q):x.searchParams.delete('q');history.pushState({},'',x)}if(!q){list.innerHTML='<div class="c24-zero-empty"><p>Введіть VIN, марку або модель.</p></div>';return}if(/^[A-HJ-NPR-Z0-9]{17}$/i.test(q)){location.href=base+'vin/?vin='+encodeURIComponent(q.toUpperCase());return}list.innerHTML='<div class="c24-zero-empty"><p>Шукаємо…</p></div>';try{const r=await fetch(API+'/catalog?limit=500');const j=await r.json();const rows=(j.data||[]).filter(m=>(String(m.make_name||'')+' '+String(m.model_name||'')).toLowerCase().includes(q.toLowerCase())).slice(0,12);list.innerHTML=rows.length?rows.map(m=>{const type=m.vehicle_type==='moto'?'moto':'cars',make=m.make_slug||slug(m.make_name),model=m.model_slug||slug(m.model_name),url=base+type+'/'+make+'/'+model+'/';return '<article><div><span>'+esc(m.vehicle_type||'')+'</span><h2><a href="'+url+'">'+esc(m.make_name)+' '+esc(m.model_name)+'</a></h2><p>'+esc(m.year_from||'')+'–'+esc(m.year_to||'актуально')+'</p></div><a class="c24-search-arrow" href="'+url+'">→</a></article>'}).join(''):'<div class="c24-zero-empty"><p>Нічого не знайдено.</p></div>'}catch{list.innerHTML='<div class="c24-zero-empty"><p>Пошук тимчасово недоступний.</p></div>'}}form.addEventListener('submit',e=>{e.preventDefault();run(input.value,true)});const q=new URLSearchParams(location.search).get('q');if(q)run(q,false)});</script></WpLayout>
