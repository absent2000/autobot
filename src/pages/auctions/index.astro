---
import BaseLayout from '../../layouts/BaseLayout.astro';
const BASE='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api';
let models:any[]=[];try{const r=await fetch(`${BASE}/catalog?limit=500`);if(r.ok){const j=await r.json();models=j.data||[];}}catch{}
const type=(Astro.url.searchParams.get('type')==='moto'?'moto':'car');
const rawQ=(Astro.url.searchParams.get('q')||'').trim();
const q=rawQ.toLowerCase();
const make=Astro.url.searchParams.get('make')||'';
const makes=Array.from(new Map(models.filter(m=>m.vehicle_type===type).map(m=>[m.make_slug,m.make_name])).entries());
const isVin=/^[A-HJ-NPR-Z0-9]{17}$/i.test(rawQ);
let realLots:any[]=[];
if(isVin){try{const r=await fetch(`${BASE}/vin?vin=${encodeURIComponent(rawQ.toUpperCase())}`);if(r.ok){const j=await r.json();realLots=(j.auction_lots||[]).map((lot:any)=>({...lot,_vin:rawQ.toUpperCase()}));}}catch{}}
const getAuction=(lot:any)=>lot.auction_house||lot.auction||lot.source_name||'auction';
const getLotId=(lot:any)=>String(lot.lot_number||lot.lot_id||lot.id||'');
const lotHref=(lot:any)=>`/lot/?auction=${encodeURIComponent(getAuction(lot))}&lot=${encodeURIComponent(getLotId(lot))}&vin=${encodeURIComponent(lot.vin||lot._vin||'')}`;
---
<BaseLayout title="Аукціони США — Cars24" description="Пошук конкретних аукціонних лотів США. Результат відкриває картку лота Cars24, а не енциклопедію чи VIN-паспорт.">
<main class="auctionPage"><div class="shell">
 <form class="auctionSearch"><input type="hidden" name="type" value={type}/><input name="q" value={rawQ} placeholder="VIN, марка, модель або Lot ID"/><button type="submit">Знайти</button></form>
 <div class="typeTabs"><a class={type==='car'?'active':''} href="/auctions/?type=car">Авто</a><a class={type==='moto'?'active':''} href="/auctions/?type=moto">Мото</a></div>
 <div class="auctionLayout">
  <aside class="filters"><div class="filterHead"><strong>Фільтр</strong><a href={`/auctions/?type=${type}`}>Скинути</a></div><div class="saved"><b>Аукціонний пошук</b><p>У результатах мають бути тільки конкретні Copart/IAAI/Buy Now лоти. Каталог моделей тут більше не підміняє аукціонний inventory.</p></div><form><input type="hidden" name="type" value={type}/><label>Аукціон<select><option>Copart та IAAI</option><option>Copart</option><option>IAAI</option></select></label><label>Марка<select name="make"><option value="">Усі марки</option>{makes.map(([slug,name])=><option value={slug} selected={make===slug}>{name}</option>)}</select></label><label>Модель<input name="q" value={rawQ} placeholder="Усі моделі"/></label><div class="two"><label>Рік від<input placeholder="2018"/></label><label>Рік до<input placeholder="2026"/></label></div><button class="apply" type="submit">Показати</button></form></aside>
  <section class="results"><nav class="resultTabs"><a class="active">Усі</a><a>Buy Now</a><a>Copart</a><a>IAAI</a></nav>
   <div class="resultBar"><div>{isVin?<><strong>{realLots.length}</strong> реальних лотів по VIN</>:<><strong>—</strong> live inventory</>}</div><div><button>Сортувати ↕</button></div></div>
   {realLots.length>0?<div class="resultList">{realLots.map((lot:any)=><article class="auctionCard"><a class="auctionPhoto" href={lotHref(lot)}>{lot.image_url||lot.primary_image?<img src={lot.image_url||lot.primary_image} alt={lot.title||rawQ} loading="lazy"/>:<span>Cars24 LOT</span>}<b>{getAuction(lot)}</b></a><div class="auctionInfo"><h2><a href={lotHref(lot)}>{lot.title||[lot.year,lot.make,lot.model].filter(Boolean).join(' ')||rawQ}</a></h2><div class="auctionMeta">Lot {getLotId(lot)||'—'} · VIN {lot.vin||lot._vin}</div><div class="tags"><span>Конкретний лот</span>{lot.status&&<span>{lot.status}</span>}</div><div class="auctionBottom"><div><small>Live ставка</small><strong>{lot.current_bid_usd?`$${Number(lot.current_bid_usd).toLocaleString('en-US')}`:'—'}</strong></div><div class="buy"><small>Buy Now</small><strong>{lot.buy_now_usd?`$${Number(lot.buy_now_usd).toLocaleString('en-US')}`:'—'}</strong></div><a aria-label="Відкрити картку лота" href={lotHref(lot)}>→</a></div></div></article>)}</div>:
   <div class="emptyState"><b>{rawQ?(isVin?'По цьому VIN у поточному Vehicle Graph аукціонних лотів не знайдено.':'Пошук по марці/моделі ще не підключений до live Copart/IAAI inventory.'):'Введіть VIN, Lot ID, марку або модель.'}</b><p>Ми більше не показуємо тут моделі з енциклопедії як псевдо-лоти. Коли підключимо live inventory API, кожен результат відкриватиме окрему картку конкретного лота.</p></div>}
  </section>
 </div>
</div></main>
</BaseLayout>
<style>
.auctionPage{background:#f7f7f7;padding:24px 0 70px;color:#17191c}.auctionSearch{display:flex;max-width:760px;margin:0 auto 22px;background:#fff;border-radius:14px;overflow:hidden}.auctionSearch input{flex:1;border:0;padding:17px 20px;font-size:15px;outline:0}.auctionSearch button{border:0;background:#ffd000;font-weight:850;padding:0 30px}.typeTabs{display:flex;gap:8px;justify-content:center;margin-bottom:20px}.typeTabs a{padding:9px 16px;border-radius:999px;background:#fff;font-weight:800;color:#66717a}.typeTabs a.active{background:#111820;color:#fff}.auctionLayout{display:grid;grid-template-columns:330px 1fr;gap:24px;align-items:start}.filters{background:#fff;border-radius:20px;overflow:hidden}.filterHead{display:flex;justify-content:space-between;padding:28px 26px;border-bottom:1px solid #eee}.saved{padding:24px 26px;border-bottom:1px solid #eee}.saved p{font-size:13px;line-height:1.55;color:#92979d;margin:10px 0 0}.filters form{padding:4px 26px 26px}.filters label{display:block;margin-top:18px;font-size:12px;font-weight:750}.filters select,.filters input{display:block;width:100%;margin-top:7px;padding:11px;border:1px solid #e4e5e7;border-radius:9px;background:#fff}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.apply{width:100%;border:0;background:#ffd000;border-radius:9px;padding:13px;font-weight:900;margin-top:20px}.resultTabs{height:62px;display:grid;grid-template-columns:repeat(4,1fr);align-items:end;border-bottom:1px solid #ddd}.resultTabs a{font-size:18px;text-align:center;padding:0 10px 18px;position:relative}.resultTabs a.active{font-weight:800}.resultTabs a.active:after{content:'';position:absolute;bottom:-1px;left:18%;right:18%;height:3px;background:#ffd000}.resultBar{display:flex;justify-content:space-between;align-items:center;padding:16px 0}.resultBar button{border:0;background:none;padding:10px 15px}.resultList{display:grid;gap:14px}.auctionCard{display:grid;grid-template-columns:300px 1fr;background:#fff;border-radius:20px;padding:22px;min-height:205px}.auctionPhoto{height:205px;border-radius:14px;overflow:hidden;position:relative;background:#f0f0f0;display:grid;place-items:center}.auctionPhoto img{width:100%;height:100%;object-fit:cover}.auctionPhoto>b{position:absolute;left:12px;top:12px;background:#111;color:#fff;padding:5px 8px;border-radius:6px;font-size:11px}.auctionPhoto>span{font-weight:900;color:#9ba0a5}.auctionInfo{padding:4px 8px 0 26px;display:flex;flex-direction:column}.auctionInfo h2{font-size:20px;line-height:1.35;margin:0 0 12px}.auctionMeta{color:#969ba0;font-size:14px}.tags{display:flex;gap:9px;margin-top:18px}.tags span{background:#f0f7ef;color:#218a3b;padding:7px 11px;border-radius:6px;font-size:12px;font-weight:750}.tags span:first-child{background:#fff4e8;color:#b96810}.auctionBottom{margin-top:auto;display:flex;align-items:end;gap:28px}.auctionBottom small{display:block;color:#999}.auctionBottom strong{font-size:28px}.auctionBottom .buy strong{font-size:20px}.auctionBottom>a{margin-left:auto;font-size:28px}.emptyState{background:#fff;border-radius:20px;padding:38px;margin-top:8px}.emptyState b{font-size:20px}.emptyState p{color:#7d848a;line-height:1.6;max-width:720px;margin:12px 0 0}@media(max-width:1000px){.auctionLayout{grid-template-columns:1fr}.filters{display:none}}@media(max-width:650px){.auctionCard{grid-template-columns:1fr;padding:12px}.auctionPhoto{height:220px}.auctionInfo{padding:18px 5px 5px}.resultTabs{overflow:auto;display:flex;align-items:end}.resultTabs a{min-width:120px}.auctionBottom{flex-wrap:wrap}}
</style>
