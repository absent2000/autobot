---
import BaseLayout from '../../layouts/BaseLayout.astro';
const BASE='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api';
let models:any[]=[];try{const r=await fetch(`${BASE}/catalog?limit=500`);if(r.ok){const j=await r.json();models=j.data||[];}}catch{}
const type=(Astro.url.searchParams.get('type')==='moto'?'moto':'car');
const q=(Astro.url.searchParams.get('q')||'').toLowerCase();
const make=Astro.url.searchParams.get('make')||'';
const filtered=models.filter(m=>m.vehicle_type===type&&(!make||m.make_slug===make)&&(!q||`${m.make_name} ${m.model_name}`.toLowerCase().includes(q))).slice(0,24);
const makes=Array.from(new Map(models.filter(m=>m.vehicle_type===type).map(m=>[m.make_slug,m.make_name])).entries());
---
<BaseLayout title="Аукціони США — Cars24" description="Пошук авто і мото з аукціонів США у дизайні Cars24.">
<main class="auctionPage"><div class="shell">
 <form class="auctionSearch"><input type="hidden" name="type" value={type}/><input name="q" value={Astro.url.searchParams.get('q')||''} placeholder="VIN, марка, модель або Lot ID"/><button type="submit">Знайти</button></form>
 <div class="typeTabs"><a class={type==='car'?'active':''} href="/auctions/?type=car">Авто</a><a class={type==='moto'?'active':''} href="/auctions/?type=moto">Мото</a></div>
 <div class="auctionLayout">
  <aside class="filters"><div class="filterHead"><strong>Фільтр</strong><a href={`/auctions/?type=${type}`}>Скинути</a></div><div class="saved"><b>Збережені пошуки <em>NEW</em></b><p>Структура з WordPress-теми перенесена. Live inventory підключимо окремим API-шаром.</p></div><form><input type="hidden" name="type" value={type}/><label>Аукціон<select><option>Copart та IAAI</option><option>Copart</option><option>IAAI</option></select></label><label>Марка<select name="make"><option value="">Усі марки</option>{makes.map(([slug,name])=><option value={slug} selected={make===slug}>{name}</option>)}</select></label><label>Модель<input name="q" value={Astro.url.searchParams.get('q')||''} placeholder="Усі моделі"/></label><div class="two"><label>Рік від<input placeholder="2018"/></label><label>Рік до<input placeholder="2026"/></label></div><button class="apply" type="submit">Показати</button></form></aside>
  <section class="results"><nav class="resultTabs"><a class="active">Усі</a><a>Buy Now</a><a>Copart</a><a>IAAI</a></nav><div class="resultBar"><div><strong>{filtered.length}</strong> моделей у поточній вибірці</div><div><button>Сортувати ↕</button></div></div><div class="resultList">{filtered.map((m:any,i:number)=><article class="auctionCard"><a class="auctionPhoto" href={`/catalog/${m.vehicle_type}/${m.make_slug}/${m.model_slug}/`}>{m.image_url?<img src={m.image_url} alt={`${m.make_name} ${m.model_name}`} loading="lazy"/>:<span>Cars24</span>}<b>{i%2?'IAAI':'Copart'}</b></a><div class="auctionInfo"><h2><a href={`/catalog/${m.vehicle_type}/${m.make_slug}/${m.model_slug}/`}>{m.year_from||'—'} {m.make_name} {m.model_name}</a></h2><div class="auctionMeta">{m.year_from||'—'}–{m.year_to||'дотепер'} · {m.vehicle_type==='moto'?'Мото':'Авто'}</div><div class="tags"><span>Каталог Cars24</span><span>Whitelist</span></div><div class="auctionBottom"><div><small>Live ставка</small><strong>—</strong></div><div class="buy"><small>Buy Now</small><strong>—</strong></div><a href={`/catalog/${m.vehicle_type}/${m.make_slug}/${m.model_slug}/`}>→</a></div></div></article>)}</div><div class="notice">Дизайн пошуку перенесено з WordPress. Live Copart/IAAI inventory і реальні ставки підключаємо до цієї оболонки окремо — без демо-цін.</div></section>
 </div>
</div></main>
</BaseLayout>
<style>
.auctionPage{background:#f7f7f7;padding:24px 0 70px;color:#17191c}.auctionSearch{display:flex;max-width:760px;margin:0 auto 22px;background:#fff;border-radius:14px;overflow:hidden}.auctionSearch input{flex:1;border:0;padding:17px 20px;font-size:15px;outline:0}.auctionSearch button{border:0;background:#ffd000;font-weight:850;padding:0 30px}.typeTabs{display:flex;gap:8px;justify-content:center;margin-bottom:20px}.typeTabs a{padding:9px 16px;border-radius:999px;background:#fff;font-weight:800;color:#66717a}.typeTabs a.active{background:#111820;color:#fff}.auctionLayout{display:grid;grid-template-columns:330px 1fr;gap:24px;align-items:start}.filters{background:#fff;border-radius:20px;overflow:hidden}.filterHead{display:flex;justify-content:space-between;padding:28px 26px;border-bottom:1px solid #eee}.saved{padding:24px 26px;border-bottom:1px solid #eee}.saved em{font-style:normal;font-size:11px;color:#ff5b5b;background:#fff0f0;border-radius:5px;padding:4px 7px;margin-left:6px}.saved p{font-size:13px;line-height:1.55;color:#92979d;margin:10px 0 0}.filters form{padding:4px 26px 26px}.filters label{display:block;margin-top:18px;font-size:12px;font-weight:750}.filters select,.filters input{display:block;width:100%;margin-top:7px;padding:11px;border:1px solid #e4e5e7;border-radius:9px;background:#fff}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.apply{width:100%;border:0;background:#ffd000;border-radius:9px;padding:13px;font-weight:900;margin-top:20px}.resultTabs{height:62px;display:grid;grid-template-columns:repeat(4,1fr);align-items:end;border-bottom:1px solid #ddd}.resultTabs a{font-size:18px;text-align:center;padding:0 10px 18px;position:relative}.resultTabs a.active{font-weight:800}.resultTabs a.active:after{content:'';position:absolute;bottom:-1px;left:18%;right:18%;height:3px;background:#ffd000}.resultBar{display:flex;justify-content:space-between;align-items:center;padding:16px 0}.resultBar button{border:0;background:none;padding:10px 15px}.resultList{display:grid;gap:14px}.auctionCard{display:grid;grid-template-columns:300px 1fr;background:#fff;border-radius:20px;padding:22px;min-height:205px}.auctionPhoto{height:205px;border-radius:14px;overflow:hidden;position:relative;background:#f0f0f0}.auctionPhoto img{width:100%;height:100%;object-fit:cover}.auctionPhoto>b,.auctionPhoto>span{position:absolute;left:12px;top:12px;background:#111;color:#fff;padding:5px 8px;border-radius:6px;font-size:11px}.auctionInfo{padding:4px 8px 0 26px;display:flex;flex-direction:column}.auctionInfo h2{font-size:20px;line-height:1.35;margin:0 0 12px}.auctionMeta{color:#969ba0;font-size:14px}.tags{display:flex;gap:9px;margin-top:18px}.tags span{background:#f0f7ef;color:#218a3b;padding:7px 11px;border-radius:6px;font-size:12px;font-weight:750}.tags span:first-child{background:#fff4e8;color:#b96810}.auctionBottom{margin-top:auto;display:flex;align-items:end;gap:28px}.auctionBottom small{display:block;color:#999}.auctionBottom strong{font-size:28px}.auctionBottom .buy strong{font-size:20px}.auctionBottom>a{margin-left:auto;font-size:28px}.notice{margin-top:16px;padding:14px 16px;background:#fff7df;border-radius:13px;font-size:12px;color:#776d4c}@media(max-width:1000px){.auctionLayout{grid-template-columns:1fr}.filters{display:none}}@media(max-width:650px){.auctionCard{grid-template-columns:1fr;padding:12px}.auctionPhoto{height:220px}.auctionInfo{padding:18px 5px 5px}.resultTabs{overflow:auto;display:flex;align-items:end}.resultTabs a{min-width:120px}.auctionBottom{flex-wrap:wrap}}
</style>
