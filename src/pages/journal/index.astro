---
import BaseLayout from '../../layouts/BaseLayout.astro';
const img='https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg';
const posts=[
 ['Авто','Які авто зараз вигідно везти зі США','Розбираємо моделі, ціни на аукціонах та реальну економіку після доставки в Україну.'],
 ['Електромобілі','Tesla Model 3 у 2026 році: чи є ще сенс везти зі США','Ціни, батарея, пошкодження та на що дивитися перед ставкою.'],
 ['Мото','Мотоцикл зі США: де насправді починається економія','Copart, IAAI, пошкодження та реальна вартість мотоцикла після доставки.'],
 ['Аукціони','Buy Now на Copart та IAAI: коли це справді вигідно','Чому фіксована ціна іноді цікавіша за торги і які лоти варто відстежувати.'],
 ['Авто','BMW X5 зі США: скільки коштує нормальний автомобіль','Рахуємо аукціон, логістику, розмитнення та дивимося на типові пошкодження.'],
 ['Мото','Triumph зі США: що можна знайти на американських аукціонах','Живі лоти, комплектації та особливості покупки британського мотоцикла в США.']
];
---
<BaseLayout title="Cars24 Журнал" description="Автомобілі, мотоцикли, аукціони, дані та дослідження Cars24.">
<main class="journal"><div class="shell">
 <header class="journalHead"><div class="crumbs">Головна <span>›</span> Журнал</div><div class="journalTitle"><div><h1>Cars24 Журнал</h1><p>Автомобілі, мотоцикли, аукціони, дані та досвід пригону зі США.</p></div><label class="journalSearch">⌕ <input placeholder="Пошук у журналі"/></label></div></header>
 <nav class="topics"><a class="active" href="#">Усі матеріали</a><a href="#">Авто</a><a href="#">Мото</a><a href="#">Електромобілі</a><a href="#">Аукціони США</a><a href="#">Buy Now</a><a href="#">Розрахунки</a><a href="#">Дослідження</a></nav>
 <section class="feature"><a class="featureImg" href="#"><img src={img} alt="Авто з США"/><span>Головний матеріал</span></a><div class="featureCopy"><div class="articleCat">ДАНІ CARS24</div><h2>Що вигідно везти зі США у 2026 році</h2><p>Не кожен дешевий автомобіль на Copart стає вигідним в Україні. Тут Cars24 зводить аукціони, ринок, VIN та економіку в один аналіз.</p><div class="meta">12 хв читання · 28 вересня 2026</div><a class="read" href="#">Читати матеріал →</a></div></section>
 <div class="sectionTitle"><div><h2>Нові матеріали</h2><p>Практика, цифри та автомобільні історії без зайвої теорії.</p></div><a href="#">Дивитися всі →</a></div>
 <section class="articleGrid">{posts.map((p,i)=><article class="articleCard"><a class="articleImg" href="#"><img src={img} alt={p[1]}/><span>{p[0]}</span></a><div class="articleBody"><div class="meta">8 хв · {28-i} вересня</div><h3><a href="#">{p[1]}</a></h3><p>{p[2]}</p></div></article>)}</section>
 <section class="youtube"><div><span>Cars24 · YouTube</span><h2>Не тільки читати</h2><p>Огляди машин, розрахунки, аукціони та реальний досвід — у відео.</p></div><a href="https://www.youtube.com/@cars24ua" target="_blank" rel="noopener">Дивитися YouTube</a></section>
</div></main>
</BaseLayout>
<style>
.journal{background:#f7f8fa;padding:30px 0 72px}.journalHead{margin-bottom:18px}.crumbs{font-size:13px;color:#858e98}.crumbs span{margin:0 8px;color:#b8bec5}.journalTitle{display:flex;justify-content:space-between;align-items:end;gap:30px}.journalTitle h1{font-size:48px;letter-spacing:-.05em;margin:12px 0 5px}.journalTitle p{margin:0;color:#6d7780}.journalSearch{width:min(430px,100%);height:50px;background:#fff;border-radius:13px;display:flex;align-items:center;gap:10px;padding:0 15px}.journalSearch input{border:0;outline:0;width:100%;background:transparent}.topics{display:flex;gap:8px;overflow:auto;padding:10px 0 22px}.topics a{white-space:nowrap;color:#525b64;background:#fff;border:1px solid #e2e6e9;border-radius:999px;padding:9px 13px;font-size:12px;font-weight:750}.topics a.active{background:#111820;color:#fff;border-color:#111820}.feature{display:grid;grid-template-columns:1.3fr 1fr;background:#fff;border-radius:20px;overflow:hidden}.featureImg{height:430px;position:relative}.featureImg img{width:100%;height:100%;object-fit:cover}.featureImg span{position:absolute;left:18px;top:18px;background:#ffd000;color:#111;padding:7px 10px;border-radius:8px;font-size:11px;font-weight:850}.featureCopy{padding:42px;display:flex;flex-direction:column;justify-content:center}.articleCat{font-size:11px;font-weight:900;letter-spacing:.1em;color:#b68a00}.featureCopy h2{font-size:38px;line-height:1.05;letter-spacing:-.04em;margin:12px 0}.featureCopy p{color:#65707a;line-height:1.7}.meta{font-size:11px;color:#89919a}.read{margin-top:18px;color:#111;font-weight:850}.sectionTitle{display:flex;justify-content:space-between;align-items:end;margin:42px 0 16px}.sectionTitle h2{font-size:28px;margin:0}.sectionTitle p{margin:4px 0 0;color:#737d86}.sectionTitle a{font-weight:800}.articleGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.articleCard{background:#fff;border-radius:16px;overflow:hidden}.articleImg{display:block;height:210px;position:relative}.articleImg img{width:100%;height:100%;object-fit:cover}.articleImg span{position:absolute;left:12px;bottom:12px;background:#fff;padding:6px 9px;border-radius:7px;color:#111;font-size:10px;font-weight:850}.articleBody{padding:17px}.articleBody h3{font-size:18px;line-height:1.3;margin:9px 0}.articleBody p{font-size:13px;line-height:1.6;color:#6e7780}.youtube{margin-top:34px;background:#fff7df;border-radius:20px;padding:28px 30px;display:flex;justify-content:space-between;align-items:center;gap:25px}.youtube span{font-size:11px;font-weight:900}.youtube h2{margin:5px 0}.youtube p{margin:0;color:#6c747c}.youtube>a{background:#ffd000;color:#111;padding:13px 18px;border-radius:12px;font-weight:900}@media(max-width:900px){.feature{grid-template-columns:1fr}.articleGrid{grid-template-columns:1fr 1fr}.featureImg{height:300px}}@media(max-width:620px){.journalTitle,.youtube{align-items:flex-start;flex-direction:column}.journalSearch{width:100%}.journalTitle h1{font-size:36px}.articleGrid{grid-template-columns:1fr}.featureImg{height:260px}.featureCopy{padding:24px}.featureCopy h2{font-size:30px}}
</style>
