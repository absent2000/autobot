---
import WpLayout from '../../layouts/WpLayout.astro';import {catalog,demoLot,u} from '../../lib/cars24';
const all=await catalog();const type=Astro.url.searchParams.get('type')==='moto'?'moto':'car';const make=Astro.url.searchParams.get('make')||'';const q=(Astro.url.searchParams.get('q')||'').toLowerCase();let rows=all.filter((r:any)=>r.vehicle_type===type&&(!make||r.make_name===make)&&(!q||`${r.make_name} ${r.model_name}`.toLowerCase().includes(q))).slice(0,24);const makes=[...new Set(all.filter((r:any)=>r.vehicle_type===type).map((r:any)=>r.make_name))];
---
<WpLayout title="Авто з аукціонів США — Guazi UI"><main class="c24-gz c24-v16-search"><div class="c24-shell"><form class="c24-gz-search"><input type="hidden" name="type" value={type}><input name="q" value={Astro.url.searchParams.get('q')||''} placeholder="VIN, марка, модель або Lot ID"><button>Знайти</button></form><div class="c24-v16-search-type"><a class={type==='car'?'active':''} href={u('/auction-search-guazi/?type=car')}>Авто</a><a class={type==='moto'?'active':''} href={u('/auction-search-guazi/?type=moto')}>Мото</a></div><div class="c24-gz-layout"><aside class="c24-gz-filter"><div class="c24-gz-filterhead"><strong>Фільтр</strong><a href={u('/auction-search-guazi/?type='+type)}>Скинути</a></div><div class="c24-gz-saved"><b>Збережені пошуки <em>NEW</em></b><p>У production тут збережемо criteria та alerts. У v16 перевіряємо структуру на всьому whitelist.</p></div><div class="c24-gz-pop"><h3>Популярні марки</h3><div>{makes.slice(0,8).map((m:any)=><a href={u(`/auction-search-guazi/?type=${type}&make=${encodeURIComponent(m)}`)}>{m}</a>)}</div></div></aside><section class="c24-gz-results"><nav class="c24-gz-tabs"><a class="active">Усі</a><a>Buy Now</a><a>Copart</a><a>IAAI</a></nav><div class="c24-gz-resultbar"><div><strong>{rows.length}</strong> моделей у whitelist</div><div><button class="offer">Є Buy Now</button><button>Сортувати ↕</button></div></div><div class="c24-gz-list">{rows.map((r:any)=>{const lot=demoLot(r,1);return <article class="c24-gz-card"><a class="c24-gz-photo" href={u(`/lot/${lot.id.toLowerCase()}/`)}><img src={r.image_url||'https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg'} alt={`${r.make_name} ${r.model_name}`}><span>{lot.auction}</span></a><div class="c24-gz-info"><h2><a href={u(`/lot/${lot.id.toLowerCase()}/`)}>{lot.year} {r.make_name} {r.model_name}</a></h2><div class="c24-gz-meta">{lot.odo.toLocaleString('en-US')} mi <i></i> {r.class_name||''}</div><div class="c24-gz-tags"><span>Lot {lot.lot}</span><span>{lot.damage}</span><span>DEMO</span></div><div class="c24-gz-bottom"><div><small>Поточна ставка</small><strong>${lot.bid.toLocaleString('en-US')}</strong></div><div class="buy"><small>Buy Now</small><strong>${lot.buy.toLocaleString('en-US')}</strong></div><div class="c24-gz-actions"><a href={u(`/lot/${lot.id.toLowerCase()}/`)}>→</a></div></div></div></article>})}</div></section></div></div></main></WpLayout>
