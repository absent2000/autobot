---
import WpLayout from '../../layouts/WpLayout.astro';import {API} from '../../lib/cars24';
---
<WpLayout title="Авто з аукціонів США — Guazi UI"><main class="c24-gz c24-v16-search"><div class="c24-shell"><form class="c24-gz-search" data-auction-search><input name="q" placeholder="VIN, марка, модель або Lot ID"/><button type="submit">Знайти</button></form><div class="c24-v16-search-type"><a data-type="car">Авто</a><a data-type="moto">Мото</a></div><div class="c24-gz-layout"><aside class="c24-gz-filter"><div class="c24-gz-filterhead"><strong>Фільтр</strong><button type="button" data-reset>Скинути</button></div><div class="c24-gz-saved"><b>Збережені пошуки <em>NEW</em></b><p>У production тут збережемо criteria та alerts. У v16 перевіряємо структуру на всьому whitelist.</p></div><div class="c24-gz-pop"><h3>Популярні марки</h3><div data-popular></div></div><form data-filter-form><label>Аукціон<select><option>Copart та IAAI</option><option>Copart</option><option>IAAI</option></select></label><label>Марка<select name="make"><option value="">Усі марки</option></select></label><label>Модель<input name="model" placeholder="Усі моделі"/></label><div class="c24-gz-two"><label>Рік від<input placeholder="2018"/></label><label>Рік до<input placeholder="2026"/></label></div><div class="c24-gz-two"><label>Ставка від<input placeholder="$"/></label><label>Ставка до<input placeholder="$"/></label></div><button class="c24-ui-primary c24-v16-filter-submit" type="submit">Показати</button></form></aside><section class="c24-gz-results"><nav class="c24-gz-tabs"><a class="active" data-tab="all">Усі</a><a data-tab="buy">Buy Now</a><a>Copart</a><a>IAAI</a></nav><div class="c24-gz-resultbar"><div><strong data-count>0</strong> моделей у whitelist</div><div><button class="offer">Є Buy Now</button><button>Сортувати ↕</button></div></div><div class="c24-gz-list" data-results></div><div class="c24-v16-more-note" data-more hidden></div></section></div></div></main><script is:inline define:vars={{API,base:import.meta.env.BASE_URL}}>document.addEventListener('DOMContentLoaded',async()=>{const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));let data=[];try{const r=await fetch(API+'/catalog?limit=500');const j=await r.json();data=j.data||[]}catch{}let type=new URLSearchParams(location.search).get('type')==='moto'?'moto':'car';const search=document.querySelector('[data-auction-search]'),qInput=search.querySelector('input'),f=document.querySelector('[data-filter-form]'),makeSel=f.querySelector('[name=make]'),modelInput=f.querySelector('[name=model]'),pop=document.querySelector('[data-popular]'),results=document.querySelector('[data-results]'),count=document.querySelector('[data-count]'),more=document.querySelector('[data-more]');let buyOnly=new URLSearchParams(location.search).get('buy-now')==='1';function crc32(str){let c=-1;for(let i=0;i<str.length;i++){c^=str.charCodeAt(i);for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xEDB88320:0)}return(c^-1)>>>0}function lot(r,index=1){const t=r.vehicle_type==='moto'?'MOTO':'CAR',seed=crc32(t+'|'+r.make_name+'|'+r.model_name),from=r.year_from||2018,to=r.year_to||2026,year=Math.min(to,Math.max(from,2022+(seed%4))),bid=1200+(seed%11800),buy=bid+1700+(seed%4900),dam=['Front End','Rear End','Side','Minor Dent / Scratches','Mechanical'],b='DEMO-'+String(seed%9999).padStart(4,'0');return{year:Math.max(from,year-(index%3)),auction:index%2?'IAAI':'Copart',lot:b,id:b+'-'+(index+1),odo:6500+(seed%49000)+(index*6900),damage:dam[seed%dam.length],bid:bid+(index*750),buy:buy+(index*1050)}}function setType(t){type=t;document.querySelectorAll('[data-type]').forEach(a=>a.classList.toggle('active',a.dataset.type===type));fillMakes();render()}function fillMakes(){const makes=[...new Set(data.filter(r=>r.vehicle_type===type).map(r=>r.make_name))].sort();const keep=new URLSearchParams(location.search).get('make')||'';makeSel.innerHTML='<option value="">Усі марки</option>'+makes.map(x=>'<option '+(x===keep?'selected':'')+' value="'+esc(x)+'">'+esc(x)+'</option>').join('');pop.innerHTML=makes.slice(0,8).map(x=>'<a href="#" data-make="'+esc(x)+'">'+esc(x)+'</a>').join('');pop.querySelectorAll('[data-make]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();makeSel.value=a.dataset.make;render(true)}))}function render(push=false){const p=new URLSearchParams(location.search),q=(qInput.value||p.get('q')||'').trim().toLowerCase(),make=makeSel.value||p.get('make')||'',model=(modelInput.value||'').trim().toLowerCase();if(!qInput.value&&p.get('q'))qInput.value=p.get('q');let rows=data.filter(r=>r.vehicle_type===type&&(!make||r.make_name===make)&&(!q||(r.make_name+' '+r.model_name+' '+(r.class_name||'')).toLowerCase().includes(q))&&(!model||String(r.model_name||'').toLowerCase().includes(model)));const total=rows.length;rows=rows.slice(0,24);count.textContent=String(total);results.innerHTML=rows.map((r,i)=>{if(buyOnly&&i%2)return'';const l=lot(r,1),img=r.image_url||'https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg',url=base+'lot/'+l.id.toLowerCase()+'/';return '<article class="c24-gz-card"><a class="c24-gz-photo" href="'+url+'"><img src="'+esc(img)+'" alt="'+esc(r.make_name+' '+r.model_name)+'"><span>'+l.auction+'</span></a><div class="c24-gz-info"><h2><a href="'+url+'">'+l.year+' '+esc(r.make_name)+' '+esc(r.model_name)+'</a></h2><div class="c24-gz-meta">'+l.odo.toLocaleString('en-US')+' mi <i></i> '+esc(r.class_name||'')+'</div><div class="c24-gz-tags"><span>Lot '+l.lot+'</span><span>'+l.damage+'</span><span>DEMO</span></div><div class="c24-gz-bottom"><div><small>Поточна ставка</small><strong>$'+l.bid.toLocaleString('en-US')+'</strong></div><div class="buy"><small>Buy Now</small><strong>$'+l.buy.toLocaleString('en-US')+'</strong></div><div class="c24-gz-actions"><a href="'+url+'">→</a></div></div></div></article>'}).join('');more.hidden=total<=24;if(total>24)more.textContent='Показано перші 24 моделей із '+total+'.';if(push){const x=new URL(location.href);x.searchParams.set('type',type);make?x.searchParams.set('make',make):x.searchParams.delete('make');qInput.value?x.searchParams.set('q',qInput.value):x.searchParams.delete('q');buyOnly?x.searchParams.set('buy-now','1'):x.searchParams.delete('buy-now');history.pushState({},'',x)}}document.querySelectorAll('[data-type]').forEach(a=>a.addEventListener('click',()=>setType(a.dataset.type)));document.querySelector('[data-reset]').addEventListener('click',()=>{qInput.value='';modelInput.value='';makeSel.value='';buyOnly=false;render(true)});search.addEventListener('submit',e=>{e.preventDefault();render(true)});f.addEventListener('submit',e=>{e.preventDefault();render(true)});document.querySelector('[data-tab="buy"]').addEventListener('click',()=>{buyOnly=true;render(true)});document.querySelector('[data-tab="all"]').addEventListener('click',()=>{buyOnly=false;render(true)});fillMakes();setType(type)});</script></WpLayout>
