---
import WpLayout from '../../layouts/WpLayout.astro';import {u} from '../../lib/cars24';const demo='https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg';
---
<WpLayout title="Cars24 UI Kit"><main class="c24-ui-lab"><section class="c24-ui-top"><div class="c24-shell"><span class="c24-eyebrow">CARS24 · UI SYSTEM</span><h1>Cars24 Design System</h1><p>Guazi marketplace × CLASSIC.COM data UI × Cars24 yellow.</p></div></section><nav class="c24-ui-nav"><div class="c24-shell"><a href="#colors">Кольори</a><a href="#actions">Кнопки</a><a href="#badges">Статуси</a><a href="#vehicle">Авто</a><a href="#filter">Фільтри</a><a href="#data">Дані</a><a href="#cta">CTA</a><a href={u('/auction-search/')}>Auction V1</a><a href={u('/auction-search-guazi/')}>Auction V2</a></div></nav><section id="colors" class="c24-ui-section"><div class="c24-shell"><span class="c24-eyebrow">FOUNDATION</span><h2>Кольорова система</h2><div class="c24-ui-swatches">{[['#FFD000','Cars24 Yellow'],['#111820','Ink'],['#F7F8FA','Canvas'],['#FFFFFF','Surface'],['#FFF7DF','Warm CTA']].map(x=><div><i style={`background:${x[0]}`}></i><b>{x[1]}</b><small>{x[0]}</small></div>)}</div></div></section><section id="actions" class="c24-ui-section c24-ui-muted"><div class="c24-shell"><span class="c24-eyebrow">ACTIONS</span><h2>Кнопки та tabs</h2><div class="c24-ui-row"><button class="c24-ui-primary">Отримати розрахунок</button><button class="c24-ui-dark">Дивитися лот</button><button class="c24-ui-quiet">Зберегти</button><button class="c24-ui-icon">♡</button></div><div class="c24-ui-tabs"><button class="active">Усі авто</button><button>Buy Now</button><button>Copart</button><button>IAAI</button></div></div></section><section id="badges" class="c24-ui-section"><div class="c24-shell"><span class="c24-eyebrow">STATUS</span><h2>Badges</h2><div class="c24-ui-row"><span class="c24-ui-badge black">Copart</span><span class="c24-ui-badge blue">IAAI</span><span class="c24-ui-badge yellow">Buy Now</span><span class="c24-ui-badge green">Run & Drive</span><span class="c24-ui-badge orange">Front End</span><span class="c24-ui-badge gray">Salvage Title</span></div></div></section><section id="vehicle" class="c24-ui-section c24-ui-muted"><div class="c24-shell"><span class="c24-eyebrow">GUAZI DNA</span><h2>Картка автомобіля</h2><article class="c24-ui-car"><div class="c24-ui-carphoto"><img src={demo} alt=""/><span>Copart</span></div><div class="c24-ui-carbody"><div class="c24-ui-kicker">Lot 65847199 · FL</div><h3>2021 BMW X5 xDrive40i</h3><p>34,812 mi <i></i> 3.0L Gasoline <i></i> AWD</p><div class="c24-ui-tags"><span>Front End</span><span>Salvage Title</span><span>Є ключі</span></div><div class="c24-ui-price"><div><small>Поточна ставка</small><strong>$8,700</strong></div><div><small>Buy Now</small><b>$12,900</b></div><button class="c24-ui-icon">♡</button></div></div></article></div></section><section id="filter" class="c24-ui-section"><div class="c24-shell"><span class="c24-eyebrow">SEARCH</span><h2>Фільтри</h2><div class="c24-ui-filter"><label>Марка<select><option>BMW</option></select></label><label>Модель<select><option>Усі моделі</option></select></label><label>Рік від<input value="2019"/></label><label>Рік до<input value="2026"/></label><label>Паливо<select><option>Усі</option></select></label><button class="c24-ui-primary">Показати 1 248 авто</button></div></div></section><section id="data" class="c24-ui-section c24-ui-muted"><div class="c24-shell"><span class="c24-eyebrow">CLASSIC.COM DNA</span><h2>Data / Market Intelligence</h2><div class="c24-ui-data"><div class="c24-ui-metric"><small>Середня ціна</small><strong>$14,820</strong><span>за 90 днів</span></div><div class="c24-ui-metric"><small>Продано</small><strong>148</strong><span>лотів</span></div><div class="c24-ui-metric"><small>Діапазон</small><strong>$9.4–21.8k</strong><span>ринок</span></div><div class="c24-ui-chart"><div class="line"></div><span>$22k</span><span>$18k</span><span>$14k</span><span>$10k</span></div></div></div></section><section id="cta" class="c24-ui-section"><div class="c24-shell"><span class="c24-eyebrow">CARS24 SIGNATURE</span><h2>Двоколірний CTA</h2><div class="c24-ui-cta"><div><h3>Хочете такий самий автомобіль?</h3><p>Підберемо схожі лоти та зробимо точний розрахунок до покупки.</p></div><button class="c24-ui-primary">Залишити заявку</button></div></div></section></main></WpLayout>
