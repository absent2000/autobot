---
import BaseLayout from '../../layouts/BaseLayout.astro';
const API='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api';
const vin=(Astro.url.searchParams.get('vin')||'').trim().toUpperCase();
const auction=(Astro.url.searchParams.get('auction')||'').trim();
const lot=(Astro.url.searchParams.get('lot')||'').trim();
let graph:any=null;
if(vin){try{const r=await fetch(`${API}/vin?vin=${encodeURIComponent(vin)}`);if(r.ok) graph=await r.json();}catch{}}
const lots=graph?.auction_lots||[];
const exact=lots.find((x:any)=>String(x.lot_number||x.lot_id||x.id||'')===lot) || lots[0] || null;
const vehicle=graph?.vehicle||null;
const model=graph?.model||null;
const photos=(graph?.photos||[]).map((p:any)=>p?.url||p).filter(Boolean);
const title=exact?.title || [vehicle?.year,vehicle?.make,vehicle?.model].filter(Boolean).join(' ') || (vin?`Лот ${vin}`:'Картка аукціонного лота');
const sourceUrl=exact?.source_url||exact?.url||'';
const modelUrl=model?.vehicle_type&&model?.make_slug&&model?.model_slug?`/catalog/${model.vehicle_type}/${model.make_slug}/${model.model_slug}/`:'';
const auctionUrl=model?.make_slug&&model?.model_slug?`/auctions/?q=${encodeURIComponent(`${vehicle?.make||''} ${vehicle?.model||''}`.trim())}`:'/auctions/';
const bid=exact?.current_bid_usd||exact?.sale_price_usd||null;
const buy=exact?.buy_now_usd||null;
const odo=exact?.odometer||exact?.odometer_miles||null;
const damage=exact?.primary_damage||exact?.damage||'—';
const location=exact?.yard_name||exact?.location||'—';
const saleDate=exact?.sale_date||exact?.auction_date||'—';
const status=exact?.status||exact?.sale_status||'—';
const cls=vehicle?.body_class||vehicle?.vehicle_type||'—';
---
<BaseLayout title={`${title} — Cars24`} description="Картка конкретного аукціонного лота Cars24: фото, VIN, аукціонні дані, стан і навігація до моделі та VIN-паспорта.">
<main class="vehicle-shadow-page c24-v16-lot">
 <section class="vehicle-shadow-shell shell">
  <div class="vehicle-breadcrumbs"><a href="/">Головна</a> <span>›</span> <a href="/auctions/">Аукціони</a> <span>›</span>{modelUrl&&<><a href={modelUrl}>{[vehicle?.make,vehicle?.model].filter(Boolean).join(' ')}</a> <span>›</span></>} Lot {lot||exact?.lot_number||exact?.lot_id||'—'}</div>

  <div class="c24-v16-lot-switch">{modelUrl&&<a href={modelUrl}>← Енциклопедія моделі</a>}<a href={auctionUrl}>Усі лоти цієї моделі →</a></div>

  {!vin && !lot ? <div class="shadow-card empty"><h1>Лот не вказаний</h1><p>Ця сторінка відкривається з конкретного результату аукціонного пошуку.</p><a class="vehicle-shadow-cta" href="/auctions/">До пошуку аукціонів</a></div> : <>
  <div class="vehicle-shadow-hero">
   <section class="c24v2-gallery" data-c24-gallery>
    <div class="c24v2-photo">{photos[0]?<img data-c24-gallery-main src={photos[0]} alt={title}/>:<div class="photo-placeholder">Cars24 · LOT</div>}<span class="vehicle-shadow-source">{auction||exact?.auction_house||'Аукціон США'}</span><span class="vehicle-photo-count">{photos.length?`${photos.length} фото`:'Фото'}</span></div>
    {photos.length>1&&<div class="c24v2-thumbs">{photos.slice(0,6).map((p:string,i:number)=><button type="button" class={i===0?'is-active':''}><img src={p} alt="" loading="lazy"/></button>)}</div>}
   </section>

   <aside class="vehicle-shadow-side">
    <section class="shadow-card vehicle-shadow-offer">
     <div class="vehicle-shadow-id"><span>Lot #{lot||exact?.lot_number||exact?.lot_id||'—'}</span>{vin&&<span>VIN: {vin}</span>}</div>
     <h1>{title}</h1>
     <p>{cls}</p>
     <div class="vehicle-shadow-auctionline"><strong>{auction||exact?.auction_house||'Аукціон США'}</strong><span>{location}</span><span>{status}</span></div>
     <div class="vehicle-shadow-prices"><div><small>Поточна ставка</small><strong>{bid?`$${Number(bid).toLocaleString('en-US')}`:'—'}</strong><span>Дані аукціону / історії</span></div><div><small>Buy Now</small><strong class="green">{buy?`$${Number(buy).toLocaleString('en-US')}`:'—'}</strong><span>Якщо доступно</span></div></div>
     <div class="vehicle-yellow-action"><strong>Точний розрахунок до покупки</strong><span>Логістика, аукціонний збір, митні платежі та Cars24 — окремим розрахунком.</span><a class="vehicle-shadow-cta" href="https://t.me/Egor_Cars24" target="_blank" rel="noopener">Розрахувати точну вартість</a></div>
     <div class="vehicle-shadow-benefits"><span>Фіксована комісія</span><span>Доставка під ключ</span><span>Перевірка лота</span></div>
    </section>
    <section class="shadow-card vehicle-shadow-time"><div><small>Статус</small><strong>{status}</strong></div><div><small>Дата торгів</small><strong>{saleDate}</strong></div></section>
   </aside>
  </div>

  <section class="shadow-card vehicle-shadow-specs">
   <div><small>Пробіг</small><strong>{odo?`${Number(odo).toLocaleString('en-US')} mi`:'—'}</strong></div>
   <div><small>Кузов / клас</small><strong>{cls}</strong></div>
   <div><small>Рік</small><strong>{vehicle?.year||exact?.year||'—'}</strong></div>
   <div><small>Аукціон</small><strong>{auction||exact?.auction_house||'—'}</strong></div>
   <div><small>Пошкодження</small><strong>{damage}</strong></div>
   <div><small>Lot ID</small><strong>{lot||exact?.lot_number||exact?.lot_id||'—'}</strong></div>
  </section>

  <div class="vehicle-shadow-grid">
   <section class="shadow-card"><h2>Основна інформація</h2><dl><div><dt>Марка</dt><dd>{vehicle?.make||'—'}</dd></div><div><dt>Модель</dt><dd>{modelUrl?<a href={modelUrl}>{vehicle?.model||'—'}</a>:vehicle?.model||'—'}</dd></div><div><dt>Рік</dt><dd>{vehicle?.year||exact?.year||'—'}</dd></div><div><dt>Lot ID</dt><dd>{lot||exact?.lot_number||exact?.lot_id||'—'}</dd></div><div><dt>VIN</dt><dd>{vin||exact?.vin||'—'}</dd></div></dl></section>
   <section class="shadow-card"><h2>Стан та пошкодження</h2><dl><div><dt>Основне пошкодження</dt><dd>{damage}</dd></div><div><dt>Пробіг</dt><dd>{odo?`${Number(odo).toLocaleString('en-US')} mi`:'—'}</dd></div><div><dt>Ключі</dt><dd>{exact?.keys??'—'}</dd></div><div><dt>Run & Drive</dt><dd>{exact?.run_and_drive??exact?.run_drive??'—'}</dd></div><div><dt>Майданчик</dt><dd>{location}</dd></div></dl></section>
   <section class="shadow-card"><h2>Навігація</h2><dl>{modelUrl&&<div><dt>Модель</dt><dd><a href={modelUrl}>Енциклопедія</a></dd></div>}<div><dt>Аукціони</dt><dd><a href={auctionUrl}>Усі лоти</a></dd></div>{vin&&<div><dt>VIN</dt><dd><a href={`/vin/?vin=${encodeURIComponent(vin)}`}>VIN-паспорт</a></dd></div>}{sourceUrl&&<div><dt>Джерело</dt><dd><a href={sourceUrl} target="_blank" rel="noopener">Оригінал ↗</a></dd></div>}</dl><div class="vehicle-shadow-lead"><strong>Це сторінка конкретного лота</strong><span>Вона окрема від енциклопедії моделі та VIN-паспорта.</span></div></section>
  </div>
  </>}
 </section>
</main>
</BaseLayout>
<style>
.vehicle-shadow-page{background:#f5f7f9;padding:28px 0 78px;color:#111820}.vehicle-breadcrumbs{margin-bottom:18px;color:#7d8790;font-size:12px}.vehicle-breadcrumbs a{color:#59636d;text-decoration:none}.c24-v16-lot-switch{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px;font-size:12px}.c24-v16-lot-switch a{color:#59636d;text-decoration:none;background:#fff;border-radius:999px;padding:8px 11px}.shadow-card{background:#fff;border:0;border-radius:20px}.vehicle-shadow-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;align-items:start}.c24v2-gallery{min-width:0}.c24v2-photo{height:410px;position:relative;overflow:hidden;border-radius:20px;background:#e6ebee;display:grid;place-items:center}.c24v2-photo img{width:100%;height:100%;object-fit:cover}.photo-placeholder{font:900 28px 'Barlow Condensed',sans-serif;color:#89939b}.vehicle-shadow-source{position:absolute;left:15px;top:15px;background:#102a42;color:#fff;padding:7px 10px;border-radius:8px;font-size:11px;font-weight:850}.vehicle-photo-count{position:absolute;right:15px;bottom:15px;background:rgba(16,18,21,.78);color:#fff;border-radius:8px;padding:7px 10px;font-size:11px}.c24v2-thumbs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;margin-top:10px}.c24v2-thumbs button{height:72px;border:1px solid #dde3e7;border-radius:11px;background:#e5eaed;padding:0;overflow:hidden}.c24v2-thumbs button.is-active{border:3px solid #ffd000}.c24v2-thumbs img{width:100%;height:100%;object-fit:cover}.vehicle-shadow-side{display:flex;flex-direction:column;gap:14px}.vehicle-shadow-offer{padding:25px;min-height:410px;display:flex;flex-direction:column}.vehicle-shadow-offer h1{font-family:'Barlow Condensed',sans-serif;font-size:34px;line-height:1.05;margin:14px 0 6px;letter-spacing:-.035em}.vehicle-shadow-offer>p{margin:0;color:#6d7780;font-size:13px}.vehicle-shadow-id{display:flex;gap:8px;flex-wrap:wrap}.vehicle-shadow-id span{background:#f2f4f6;padding:6px 10px;border-radius:999px;font-size:12px}.vehicle-shadow-auctionline{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0;color:#6e7881;font-size:11px}.vehicle-shadow-auctionline strong{color:#111820}.vehicle-shadow-prices{display:grid;grid-template-columns:1fr 1fr;margin:20px 0;gap:1px;background:#edf0f2;border-radius:14px;overflow:hidden}.vehicle-shadow-prices div{background:#fff;padding:17px}.vehicle-shadow-prices small{display:block;color:#76808a}.vehicle-shadow-prices strong{font-size:31px}.vehicle-shadow-prices span{display:block;color:#7a848d;font-size:10px;line-height:1.35;margin-top:5px}.vehicle-shadow-prices .green{color:#087d50}.vehicle-yellow-action{background:#fff7df;border-radius:20px;padding:18px;margin-top:auto}.vehicle-yellow-action>strong,.vehicle-yellow-action>span{display:block}.vehicle-yellow-action>strong{font-size:16px}.vehicle-yellow-action>span{font-size:11px;line-height:1.5;color:#68727b;margin-top:5px}.vehicle-shadow-cta{display:block;margin-top:12px;background:#ffd000;color:#111;border-radius:13px;padding:14px 16px;text-align:center;text-decoration:none;font-weight:900}.vehicle-shadow-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}.vehicle-shadow-benefits span{background:#f5f7f9;border-radius:10px;padding:10px 8px;text-align:center;font-size:10px;font-weight:750;line-height:1.25}.vehicle-shadow-time{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:18px 20px}.vehicle-shadow-time small,.vehicle-shadow-time strong{display:block}.vehicle-shadow-time small{font-size:9px;color:#7c858e}.vehicle-shadow-time strong{font-size:14px;margin-top:4px}.vehicle-shadow-specs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));margin:22px 0;padding:0}.vehicle-shadow-specs div{padding:19px 20px;border-right:1px solid #e9ecef;min-width:0}.vehicle-shadow-specs div:last-child{border-right:0}.vehicle-shadow-specs small,.vehicle-shadow-specs strong{display:block}.vehicle-shadow-specs small{font-size:9px;color:#7c858e}.vehicle-shadow-specs strong{font-size:14px;margin-top:5px;overflow-wrap:anywhere}.vehicle-shadow-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:start}.vehicle-shadow-grid>section{padding:23px;min-width:0}.vehicle-shadow-grid h2{font-size:19px;margin:0 0 14px}.vehicle-shadow-grid dl{margin:0}.vehicle-shadow-grid dl div{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;font-size:11px;padding:10px 0;border-bottom:1px solid #edf0f2}.vehicle-shadow-grid dt{color:#78828b;max-width:52%}.vehicle-shadow-grid dd{margin:0;text-align:right;font-weight:750;overflow-wrap:anywhere}.vehicle-shadow-grid dd a{color:#111820}.vehicle-shadow-lead{background:#fff7df;border-radius:20px;margin-top:18px;padding:17px}.vehicle-shadow-lead strong,.vehicle-shadow-lead span{display:block}.vehicle-shadow-lead span{font-size:11px;line-height:1.5;color:#68727b;margin-top:5px}.empty{padding:40px}.empty h1{font-family:'Barlow Condensed',sans-serif;font-size:42px;margin:0}.empty p{color:#68727b}@media(max-width:900px){.vehicle-shadow-hero,.vehicle-shadow-grid{grid-template-columns:1fr}.c24v2-photo{height:480px}.vehicle-shadow-specs{grid-template-columns:repeat(3,1fr)}}@media(max-width:620px){.c24-v16-lot-switch{align-items:flex-start;flex-direction:column}.c24v2-photo{height:310px;border-radius:15px}.c24v2-thumbs{grid-template-columns:repeat(3,1fr)}.c24v2-thumbs button{height:58px}.vehicle-shadow-offer{padding:20px}.vehicle-shadow-offer h1{font-size:29px}.vehicle-shadow-specs{grid-template-columns:repeat(2,1fr)}.vehicle-shadow-specs div:nth-child(2n){border-right:0}.vehicle-shadow-grid>section{padding:20px}}
</style>