const img='https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg';
const items=[['2021 BMW X5 xDrive40i','$12,900','$8,700','34,812 mi','Front End','Copart · FL','65847199','3.0L · Gasoline · AWD','Salvage Title'],['2020 BMW X5 xDrive40i','$14,500','$9,200','42,106 mi','Side','IAAI · NJ','77129413','3.0L · Gasoline · AWD','Salvage Title'],['2022 BMW X3 xDrive30i','$11,900','$6,800','29,540 mi','Rear End','Copart · TX','68431027','2.0L · Gasoline · AWD','Salvage Title'],['2021 Audi Q7 Premium Plus','$13,700','$7,600','51,220 mi','Front End','Copart · CA','69318452','3.0L · Gasoline · AWD','Salvage Title'],['2020 Mercedes-Benz GLE 350','$15,900','$10,100','38,460 mi','Minor Dent/Scratches','IAAI · IL','38910472','2.0L · Gasoline · AWD','Clean Title'],['2021 Volvo XC90 T6','$12,400','$7,100','47,800 mi','Side','Copart · GA','67155280','2.0L · Gasoline · AWD','Salvage Title']];
---
<WpLayout title="Авто з аукціонів США — Search"><main class="c24-search-page"><div class="c24-search-shell c24-shell"><div class="c24-search-head"><div><div class="vehicle-breadcrumbs">Головна <span>›</span> Авто з аукціонів США</div><h1>Авто з аукціонів США</h1><p>Актуальні лоти Copart та IAAI</p></div><label class="c24-searchbox">⌕ <input placeholder="VIN, марка, модель або Lot ID"/></label></div><div class="c24-search-layout"><aside class="c24-filters"><div class="c24-filter-title"><strong>Фільтри</strong><button>Скинути</button></div><label>Аукціон<select><option>Copart та IAAI</option><option>Copart</option><option>IAAI</option></select></label><label>Марка<select><option>Усі марки</option><option>BMW</option><option>Tesla</option><option>Audi</option></select></label><label>Модель<select><option>Усі моделі</option></select></label><div class="c24-filter-group"><span>Рік</span><div class="c24-two"><input placeholder="Від 2018"/><input placeholder="До 2026"/></div></div><div class="c24-filter-group"><span>Поточна ставка, $</span><div class="c24-two"><input placeholder="Від"/><input placeholder="До"/></div></div><div class="c24-filter-group"><span>Buy Now, $</span><div class="c24-two"><input placeholder="Від"/><input placeholder="До"/></div></div><div class="c24-filter-group"><span>Пробіг, mi</span><div class="c24-two"><input placeholder="Від"/><input placeholder="До"/></div></div><label>Тип транспорту<select><option>Усі</option><option>Automobile</option><option>Motorcycle</option><option>Truck</option></select></label><label>Тип кузова<select><option>Усі</option><option>SUV</option><option>Sedan</option><option>Coupe</option><option>Pickup</option></select></label><label>Паливо<select><option>Усі</option><option>Gasoline</option><option>Diesel</option><option>Electric</option><option>Hybrid</option></select></label><label>Об'єм двигуна<select><option>Будь-який</option><option>до 2.0 L</option><option>2.0–3.0 L</option><option>3.0 L і більше</option></select></label><label>Привід<select><option>Усі</option><option>AWD</option><option>RWD</option><option>FWD</option><option>4WD</option></select></label><label>Коробка<select><option>Усі</option><option>Automatic</option><option>Manual</option></select></label><label>Основне пошкодження<select><option>Усі типи</option><option>Front End</option><option>Side</option><option>Rear End</option><option>Minor Dent/Scratches</option></select></label><label>Документ<select><option>Усі документи</option><option>Clean Title</option><option>Salvage Title</option><option>Non-Repairable</option></select></label><label>Штат<select><option>Усі штати</option><option>CA</option><option>FL</option><option>TX</option><option>NJ</option></select></label><label class="c24-check"><input type="checkbox"/> Є Buy Now</label><label class="c24-check"><input type="checkbox"/> Є ключі</label><button class="c24-filter-apply">Показати 1 248 авто</button></aside><section class="c24-results"><div class="c24-resultsbar"><div><strong>1 248 авто</strong><span> знайдено</span></div><select><option>Спочатку актуальні</option><option>Buy Now: дешевші</option><option>Рік: новіші</option></select></div><div class="c24-car-grid">{items.map((car,i)=><article class="c24-car-card"><a class="c24-card-photo" href={u('/vehicle-card-shadow/')}><img src={img} alt={car[0]}/><span class="c24-auction-badge">{i%3===1?'IAAI':'Copart'}</span><span class="c24-card-count">1 / {18+i}</span></a><div class="c24-card-body"><div class="c24-card-lot">Lot {car[6]} · {car[5]}</div><h2><a href={u('/vehicle-card-shadow/')}>{car[0]}</a></h2><div class="c24-card-specs"><span>{car[3]}</span><span>{car[7]}</span></div><div class="c24-card-damage">Пошкодження: <strong>{car[4]}</strong><span> · {car[8]}</span></div><div class="c24-card-prices"><div><small>Поточна ставка</small><strong>{car[2]}</strong></div><div class="buy"><small>Buy Now</small><strong>{car[1]}</strong></div></div><div class="c24-card-date">Торги · 18 вересня, 17:00</div></div></article>)}</div></section></div></div></main></WpLayout>
