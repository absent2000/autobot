---
import BaseLayout from '../../layouts/BaseLayout.astro';
const API='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api/catalog?limit=500';
let models:any[]=[];let stats:any={};let loadError='';
try{const r=await fetch(API);if(!r.ok)throw new Error(`HTTP ${r.status}`);const j=await r.json();models=j.data||[];stats=j.stats||{};}catch(e){loadError=String(e);}
const grouped=(type:string)=>{
  const map=new Map<string,any>();
  for(const m of models.filter(x=>x.vehicle_type===type)){
    const key=m.make_slug;
    if(!map.has(key))map.set(key,{vehicle_type:type,make_name:m.make_name,make_slug:m.make_slug,models:[]});
    map.get(key).models.push(m);
  }
  return Array.from(map.values()).sort((a:any,b:any)=>a.make_name.localeCompare(b.make_name));
};
const carMakes=grouped('car');const motoMakes=grouped('moto');
---
<BaseLayout title="Каталог моделей Cars24" description="Енциклопедія моделей авто і мото Cars24: марки, моделі, покоління, характеристики та аукціонні дані.">
  <main class="c24-catalog-page">
    <section class="catalogHero"><div class="shell"><span>ЕНЦИКЛОПЕДІЯ CARS24</span><h1>Каталог моделей</h1><p>{stats.models_total||models.length} моделей із whitelist Cars24</p></div></section>
    <section class="catalogBody"><div class="shell">
      <div class="catalogIntro"><span>МАРКА → МОДЕЛЬ</span><h2>Оберіть марку</h2><p>Каталог — це довідник моделей Cars24. Відкриваєте марку, бачите всі відібрані моделі й переходите в енциклопедію конкретної моделі.</p></div>
      {loadError?<div class="catalogError">Каталог тимчасово не завантажився з API.</div>:<>
        <section class="brandSection"><div class="sectionHead"><h2>Авто</h2><span>{carMakes.length} марок</span></div><div class="brandGrid">{carMakes.map((make:any)=><article class="brandCard"><div class="brandHead"><a href={`/catalog/car/${make.make_slug}/`}><strong>{make.make_name}</strong></a><span>{make.models.length} моделей</span></div><div class="brandModels">{make.models.slice(0,3).map((m:any)=><a href={`/catalog/car/${m.make_slug}/${m.model_slug}/`}>{m.model_name}</a>)}</div><a class="brandMore" href={`/catalog/car/${make.make_slug}/`}>{make.models.length>3?`Ще ${make.models.length-3} моделей`:'Усі моделі'} →</a></article>)}</div></section>
        <section class="brandSection"><div class="sectionHead"><h2>Мото</h2><span>{motoMakes.length} марок</span></div><div class="brandGrid">{motoMakes.map((make:any)=><article class="brandCard"><div class="brandHead"><a href={`/catalog/moto/${make.make_slug}/`}><strong>{make.make_name}</strong></a><span>{make.models.length} моделей</span></div><div class="brandModels">{make.models.slice(0,3).map((m:any)=><a href={`/catalog/moto/${m.make_slug}/${m.model_slug}/`}>{m.model_name}</a>)}</div><a class="brandMore" href={`/catalog/moto/${make.make_slug}/`}>{make.models.length>3?`Ще ${make.models.length-3} моделей`:'Усі моделі'} →</a></article>)}</div></section>
      </>}
    </div></section>
  </main>
</BaseLayout>
<style>
.c24-catalog-page{background:#f7f8fa;min-height:70vh}.catalogHero{height:285px;display:flex;align-items:center;background:linear-gradient(90deg,rgba(8,13,18,.78),rgba(8,13,18,.12)),url('https://cars24.com.ua/wp-content/uploads/2026/09/Cars24-Challenger-Hero.png') center 51%/cover no-repeat;color:#fff}.catalogHero span{font-size:11px;font-weight:900;letter-spacing:.12em;color:#ffd000}.catalogHero h1{font-family:'Barlow Condensed',sans-serif;font-size:72px;line-height:.9;margin:7px 0 12px}.catalogHero p{margin:0;color:#d7dce0}.catalogBody{padding:34px 0 80px}.catalogIntro{padding:50px 0 30px;max-width:760px}.catalogIntro>span{font-size:11px;font-weight:900;letter-spacing:.12em;color:#9b7900}.catalogIntro h2{font-family:'Barlow Condensed',sans-serif;font-size:48px;line-height:1;margin:8px 0 16px}.catalogIntro p{font-size:17px;line-height:1.7;color:#68727a}.brandSection{margin-top:32px}.sectionHead{display:flex;justify-content:space-between;align-items:end;margin-bottom:15px}.sectionHead h2{font-family:'Barlow Condensed',sans-serif;font-size:40px;margin:0}.sectionHead span{color:#7a838c;font-size:12px}.brandGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.brandCard{background:#fff;border-radius:18px;padding:20px;min-height:180px;display:flex;flex-direction:column}.brandHead{display:flex;justify-content:space-between;gap:12px;align-items:start;padding-bottom:14px;border-bottom:1px solid #edf0f2}.brandHead strong{font-size:20px}.brandHead span{font-size:10px;color:#858e97;white-space:nowrap}.brandModels{display:flex;flex-direction:column;gap:8px;padding:14px 0}.brandModels a{font-size:13px;color:#5d6670}.brandModels a:hover{color:#111820}.brandMore{margin-top:auto;font-size:12px;font-weight:900;color:#111820}.brandMore:hover{color:#9b7900}.catalogError{background:#fff;border-radius:18px;padding:24px;color:#68727a}@media(max-width:1100px){.brandGrid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.brandGrid{grid-template-columns:repeat(2,1fr)}.catalogHero{height:230px}.catalogHero h1{font-size:56px}}@media(max-width:520px){.brandGrid{grid-template-columns:1fr}.catalogHero{height:190px}.catalogHero h1{font-size:46px}.catalogIntro{padding-top:34px}.catalogIntro h2{font-size:40px}}
</style>
