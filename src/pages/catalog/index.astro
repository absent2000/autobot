---
import WpLayout from '../../layouts/WpLayout.astro';import {catalog,u} from '../../lib/cars24';const data=await catalog();const cars=data.filter((r:any)=>r.vehicle_type==='car'),motos=data.filter((r:any)=>r.vehicle_type==='moto');function groups(rows:any[]){const m=new Map();for(const r of rows){const a=m.get(r.make_name)||[];a.push(r);m.set(r.make_name,a)}return [...m.entries()]}
---
<WpLayout title="Каталог — Cars24"><main class="c24-catalog c24-v16-brand-catalog"><section class="c24-catalog-hero"><div class="c24-shell"><div><span class="c24-v16-hero-kicker">ЕНЦИКЛОПЕДІЯ CARS24</span><h1>Каталог моделей</h1><p>{data.length} моделей із whitelist Cars24</p></div></div></section><section class="c24-v16-catalog-home"><div class="c24-shell"><div class="c24-catalog-intro"><span class="c24-eyebrow">МАРКА → МОДЕЛЬ</span><h2>Оберіть марку</h2><p>Каталог — це довідник моделей Cars24. Тут не потрібен поділ за кузовами чи класами: відкриваєте марку, бачите всі моделі й переходите в енциклопедію конкретної моделі.</p></div>{[['Авто',cars,'cars'],['Мото',motos,'moto']].map(([label,rows,path]:any)=><section class="c24-v16-catalog-section"><div class="c24-v16-catalog-section-head"><h2>{label}</h2></div><div class="c24-v16-brand-grid">{groups(rows).map(([make,models]:any)=><article class="c24-v16-brand-card"><div class="c24-v16-brand-card-head"><strong>{make}</strong><span>{models.length} моделей</span></div><div class="c24-v16-brand-models">{models.slice(0,3).map((m:any)=><a href={u(`/${path}/${m.make_slug}/${m.model_slug}/`)}>{m.model_name}</a>)}</div><a class="c24-v16-brand-more" href={u(`/${path}/${models[0].make_slug}/${models[0].model_slug}/`)}>Усі моделі →</a></article>)}</div></section>)}</div></section></main></WpLayout>
