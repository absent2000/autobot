---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ModelDetail from '../../../../components/ModelDetail';
type CatalogItem={model_id:number;vehicle_type:string;make_name:string;make_slug:string;model_name:string;model_slug:string;year_from:number|null;year_to:number|null};
export async function getStaticPaths(){const api='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api/catalog?limit=500';const r=await fetch(api);if(!r.ok)return [];const j=await r.json();return (j.data||[]).map((m:CatalogItem)=>({params:{type:m.vehicle_type,make:m.make_slug,model:m.model_slug},props:{item:m}}));}
const {type,make,model}=Astro.params;const {item}=Astro.props as {item:CatalogItem};
const canonical=`https://cars24.com.ua/catalog/${type}/${make}/${model}/`;
const jsonLd={'@context':'https://schema.org','@type':'WebPage',name:`${item.make_name} ${item.model_name} — Cars24`,url:canonical,about:{'@type':'Vehicle',name:`${item.make_name} ${item.model_name}`,manufacturer:{'@type':'Organization',name:item.make_name},model:item.model_name,vehicleModelDate:item.year_from?String(item.year_from):undefined}};
---
<BaseLayout title={`${item.make_name} ${item.model_name} — Cars24`} description={`${item.make_name} ${item.model_name}: покоління, характеристики та аукціонні дані Cars24.`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="modelPage"><div class="shell">
    <div class="modelCrumbs"><a href="/">Головна</a><span>›</span><a href="/catalog/">Каталог</a><span>›</span><a href={`/catalog/${type}/${make}/`}>{item.make_name}</a><span>›</span><b>{item.model_name}</b></div>
    <ModelDetail client:load type={type!} make={make!} model={model!} />
  </div></main>
</BaseLayout>
<style>.modelPage{background:#f7f8fa;padding:28px 0 72px}.modelCrumbs{font-size:13px;color:#858e98;margin-bottom:18px}.modelCrumbs span{margin:0 8px;color:#b8bec5}.modelCrumbs a{color:inherit}</style>
