---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ModelDetail from '../../../../components/ModelDetail';
type CatalogItem={model_id:number;vehicle_type:string;make_name:string;make_slug:string;model_name:string;model_slug:string;year_from:number|null;year_to:number|null};
export async function getStaticPaths(){
  const api='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api/catalog?limit=500';
  const r=await fetch(api); if(!r.ok)return [];
  const j=await r.json();
  return (j.data||[]).map((m:CatalogItem)=>({params:{type:m.vehicle_type,make:m.make_slug,model:m.model_slug},props:{item:m}}));
}
const {type,make,model}=Astro.params;
const {item}=Astro.props as {item:CatalogItem};
const canonical=`https://cars24.com.ua/catalog/${type}/${make}/${model}/`;
const jsonLd={
  '@context':'https://schema.org',
  '@type':'WebPage',
  name:`${item.make_name} ${item.model_name} — Cars24`,
  url:canonical,
  about:{'@type':'Vehicle',name:`${item.make_name} ${item.model_name}`,manufacturer:{'@type':'Organization',name:item.make_name},model:item.model_name,vehicleModelDate:item.year_from?String(item.year_from):undefined},
  breadcrumb:{'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'Cars24',item:'https://cars24.com.ua/'},
    {'@type':'ListItem',position:2,name:'Каталог',item:'https://cars24.com.ua/catalog/'},
    {'@type':'ListItem',position:3,name:item.make_name,item:`https://cars24.com.ua/catalog/${type}/${make}/`},
    {'@type':'ListItem',position:4,name:item.model_name,item:canonical},
  ]},
};
---
<BaseLayout title={`${item.make_name} ${item.model_name} — Cars24`} description={`${item.make_name} ${item.model_name}: покоління, характеристики та дані Cars24.`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="shell page">
    <header class="page-head"><div class="eyebrow">{item.vehicle_type==='moto'?'Мото':'Авто'} · {item.make_name}</div><h1>{item.make_name} {item.model_name}</h1><p>{item.year_from||'—'} — {item.year_to||'дотепер'}. Перевірені характеристики поколінь та джерела Cars24.</p></header>
    <ModelDetail client:load type={type!} make={make!} model={model!} />
  </div>
</BaseLayout>
