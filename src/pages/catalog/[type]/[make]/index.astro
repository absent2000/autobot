---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
type CatalogItem={model_id:number;vehicle_type:string;make_name:string;make_slug:string;model_name:string;model_slug:string;year_from:number|null;year_to:number|null;image_url?:string|null};
export async function getStaticPaths(){const api='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api/catalog?limit=500';const r=await fetch(api);if(!r.ok)return [];const j=await r.json();const all:CatalogItem[]=j.data||[];const groups=new Map<string,{type:string;make:string;makeName:string;models:CatalogItem[]}>();for(const m of all){const key=`${m.vehicle_type}:${m.make_slug}`;if(!groups.has(key))groups.set(key,{type:m.vehicle_type,make:m.make_slug,makeName:m.make_name,models:[]});groups.get(key)!.models.push(m);}return [...groups.values()].map(g=>({params:{type:g.type,make:g.make},props:g}));}
const {type,make}=Astro.params;const {makeName,models}=Astro.props as {makeName:string;models:CatalogItem[]};const count=models.length;const years=models.flatMap(m=>[m.year_from,m.year_to]).filter((v):v is number=>typeof v==='number');const yearFrom=years.length?Math.min(...years):null;const yearTo=years.length?Math.max(...years):null;
---
<BaseLayout title={`${makeName} — каталог Cars24`} description={`${makeName}: ${count} моделей у каталозі Cars24.`}>
<main class="brandPage"><div class="shell">
  <div class="crumbs"><a href="/">Головна</a><span>›</span><a href="/catalog/">Каталог</a><span>›</span><b>{makeName}</b></div>
  <header class="brandHero"><div><span>{type==='moto'?'МОТО':'АВТО'} · МАРКА</span><h1>{makeName}</h1><p>{count} моделей у каталозі Cars24{yearFrom?` · ${yearFrom}–${yearTo||'дотепер'}`:''}</p></div></header>
  <section class="brandModels"><div class="sectionHead"><div><span>МОДЕЛІ</span><h2>У каталозі Cars24</h2></div><a href="/catalog/">Усі марки →</a></div><div class="modelGrid">{models.map(m=><a class="modelCard" href={`/catalog/${m.vehicle_type}/${m.make_slug}/${m.model_slug}/`}><div class="photo">{m.image_url?<img src={m.image_url} alt={`${m.make_name} ${m.model_name}`} loading="lazy"/>:<span>{type==='moto'?'MOTO':'AUTO'}</span>}</div><div class="body"><small>{m.year_from||'—'}–{m.year_to||'дотепер'}</small><h3>{m.model_name}</h3><p>Покоління · характеристики · аукціонні дані</p></div></a>)}</div></section>
</div></main>
</BaseLayout>
<style>
.brandPage{background:#f7f8fa;padding:28px 0 72px}.crumbs{font-size:13px;color:#858e98}.crumbs span{margin:0 8px;color:#b8bec5}.brandHero{margin-top:20px;background:#111820;color:#fff;border-radius:22px;min-height:260px;padding:46px;display:flex;align-items:end;position:relative;overflow:hidden}.brandHero:after{content:'';position:absolute;right:-80px;top:-140px;width:420px;height:420px;border-radius:50%;background:#ffd000;opacity:.12}.brandHero>div{position:relative;z-index:1}.brandHero span,.sectionHead span{font-size:11px;letter-spacing:.12em;font-weight:900;color:#ffd000}.brandHero h1{font-family:'Barlow Condensed',sans-serif;font-size:72px;line-height:.9;margin:8px 0 12px;text-transform:uppercase}.brandHero p{margin:0;color:#b8c0c8}.brandModels{padding-top:38px}.sectionHead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.sectionHead span{color:#9b7900}.sectionHead h2{font-size:32px;margin:5px 0 0}.sectionHead>a{font-size:12px;font-weight:850}.modelGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.modelCard{background:#fff;border-radius:18px;overflow:hidden}.photo{height:210px;background:#eef1f3;display:grid;place-items:center;color:#8a939b;font-weight:900}.photo img{width:100%;height:100%;object-fit:cover}.body{padding:16px}.body small{color:#9b7900;font-size:10px;font-weight:900}.body h3{font-size:20px;margin:6px 0}.body p{font-size:11px;color:#737d85;margin:0}.modelCard:hover{transform:translateY(-2px)}@media(max-width:1000px){.modelGrid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.modelGrid{grid-template-columns:repeat(2,1fr)}.brandHero h1{font-size:56px}}@media(max-width:520px){.modelGrid{grid-template-columns:1fr}.brandHero{padding:28px;min-height:210px}.brandHero h1{font-size:48px}}
</style>
