---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CatalogExplorer from '../../../../components/CatalogExplorer';
type CatalogItem={model_id:number;vehicle_type:string;make_name:string;make_slug:string;model_name:string;model_slug:string;year_from:number|null;year_to:number|null;image_url?:string|null};
export async function getStaticPaths(){
  const api='https://pmjachoteyeviwwzotks.supabase.co/functions/v1/cars24-public-api/catalog?limit=500';
  const r=await fetch(api); if(!r.ok)return [];
  const j=await r.json(); const all:CatalogItem[]=j.data||[];
  const groups=new Map<string,{type:string;make:string;makeName:string;models:CatalogItem[]}>();
  for(const m of all){const key=`${m.vehicle_type}:${m.make_slug}`;if(!groups.has(key))groups.set(key,{type:m.vehicle_type,make:m.make_slug,makeName:m.make_name,models:[]});groups.get(key)!.models.push(m);}
  return [...groups.values()].map(g=>({params:{type:g.type,make:g.make},props:g}));
}
const {type,make}=Astro.params;
const {makeName,models}=Astro.props as {makeName:string;models:CatalogItem[]};
const count=models.length;
const years=models.flatMap(m=>[m.year_from,m.year_to]).filter((v):v is number=>typeof v==='number');
const yearFrom=years.length?Math.min(...years):null; const yearTo=years.length?Math.max(...years):null;
const canonical=`https://cars24.com.ua/catalog/${type}/${make}/`;
const jsonLd={'@context':'https://schema.org','@type':'CollectionPage',name:`${makeName} — каталог Cars24`,url:canonical,numberOfItems:count,breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Cars24',item:'https://cars24.com.ua/'},{'@type':'ListItem',position:2,name:'Каталог',item:'https://cars24.com.ua/catalog/'},{'@type':'ListItem',position:3,name:makeName,item:canonical}]}};
---
<BaseLayout title={`${makeName} — каталог Cars24`} description={`${makeName}: ${count} моделей у каталозі Cars24, покоління, характеристики та аукціонні дані.`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="shell page">
    <header class="page-head"><div class="eyebrow">{type==='moto'?'Мото':'Авто'} · Марка</div><h1>{makeName}</h1><p>{count} моделей у поточному каталозі Cars24{yearFrom?` · ${yearFrom}–${yearTo||'дотепер'}`:''}. Відкрийте модель, щоб перейти до поколінь, характеристик та аукціонних даних.</p></header>
    <CatalogExplorer client:load models={models} stats={{models_total:count,makes_total:1}} />
  </div>
</BaseLayout>
