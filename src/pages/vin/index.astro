---
import WpLayout from '../../layouts/WpLayout.astro';import {API,u} from '../../lib/cars24';
---
<WpLayout title="Перевірка VIN — Cars24"><main class="vin-check-page"><div class="c24-shell vin-check-topline"><span>CARS24 · VEHICLE GRAPH</span><a href={u('/home-lab/')}>← До підбору за бюджетом</a></div><section class="vin-check-hero c24-shell"><div class="vin-check-copy"><span class="vin-check-kicker">VIN / LOT / ІСТОРІЯ</span><h1>Один VIN.<br/>Одна історія автомобіля.</h1><p>Шукаємо автомобіль у даних Cars24 і не змішуємо різні сутності: VIN, аукціонний lot, спостереження джерел та події зберігаються окремо.</p><form class="vin-check-form" data-vin-form><label for="cars24-vin">VIN-код</label><div class="vin-check-inputrow"><input id="cars24-vin" name="vin" type="text" maxlength="17" minlength="17" autocomplete="off" spellcheck="false" placeholder="5YJ3E1EBXKF214092" required/><button type="submit">Перевірити</button></div><small>17 символів. Без пробілів. Літери I, O та Q у VIN не використовуються.</small></form><div class="vin-check-demo"><span>Спробувати приклад:</span><a href={u('/vin/?vin=5YJ3E1EBXKF214092')}>Tesla Model 3</a><a href={u('/vin/?vin=SMTD51HG4KT941934')}>Triumph Scrambler 1200 XE</a></div></div><aside class="vin-check-side"><span class="vin-check-side-kicker">ЩО ЗБИРАЄ CARS24</span><strong>Від сирого лота до зрозумілої хронології</strong><div><span>01</span><p><b>Ідентичність</b>VIN, марка, модель, рік і конфігурація — без підміни схожою моделлю.</p></div><div><span>02</span><p><b>Аукціони</b>Copart / IAAI, lot ID, дати, статуси та ціни як окремі факти.</p></div><div><span>03</span><p><b>Стан</b>Пошкодження, пробіг, ключі, Run & Drive і фото, коли вони підтверджені.</p></div><div><span>04</span><p><b>Економіка</b>LotScan, Max Bid, landed cost і ринок України — окремими розрахунками, коли даних достатньо.</p></div></aside></section><section class="vin-result c24-shell" data-vin-result hidden></section></main><script is:inline define:vars={{API,base:import.meta.env.BASE_URL}}>document.addEventListener('DOMContentLoaded',()=>{const form=document.querySelector('[data-vin-form]'),input=document.querySelector('#cars24-vin'),out=document.querySelector('[data-vin-result]');const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));async function run(vin,push=false){vin=(vin||'').trim().toUpperCase();input.value=vin;if(push){const x=new URL(location.href);x.searchParams.set('vin',vin);history.pushState({},'',x)}if(!vin){out.hidden=true;return}out.hidden=false;if(vin.length!==17){out.innerHTML='<div class="vin-result-empty is-error"><strong>VIN має містити 17 символів</strong><p>Перевірте введення та спробуйте ще раз.</p></div>';return}out.innerHTML='<div class="vin-result-empty"><strong>Шукаємо VIN…</strong></div>';try{const r=await fetch(API+'/vin?vin='+encodeURIComponent(vin));if(!r.ok)throw 0;const j=await r.json();const vehicle=j.vehicle||j.data?.vehicle||null,photos=j.photos||j.data?.photos||[],lots=j.auction_lots||j.data?.auction_lots||[];if(!vehicle){out.innerHTML='<div class="vin-result-empty"><span>VIN '+esc(vin)+'</span><strong>Цього VIN поки немає в Vehicle Graph</strong><p>Ми не вигадуємо результат. Коли джерело буде підключене до графа, тут з’явиться його хронологія.</p></div>';return}const lot=lots[0]||{},photo=photos[0],src=typeof photo==='string'?photo:(photo?.url||photo?.public_url||'');const name=[vehicle.year||vehicle.model_year,vehicle.make,vehicle.model].filter(Boolean).join(' ');out.innerHTML='<div class="vin-result-head"><div><span>'+esc(String(vehicle.vehicle_type||'').toUpperCase())+' · '+esc(lot.auction||vehicle.auction||'Cars24')+'</span><h2>'+esc(name)+'</h2><p>'+esc(vin)+(lot.lot_id?' · Lot '+esc(lot.lot_id):'')+'</p></div><a href="'+base+'vehicle-card-shadow/?vin='+encodeURIComponent(vin)+'">Відкрити картку →</a></div><div class="vin-result-grid"><div class="vin-result-visual">'+(src?'<img src="'+esc(src)+'" alt="'+esc(name)+'">':'<div class="vin-photo-empty">Фото поки не прив’язане</div>')+'</div><div class="vin-result-data"><div class="vin-result-metrics"><div><small>Пробіг</small><strong>'+esc(lot.odometer||vehicle.odometer||'Немає даних')+'</strong></div><div><small>Пошкодження</small><strong>'+esc(lot.primary_damage||vehicle.primary_damage||'Немає даних')+'</strong></div><div><small>Поточна ставка</small><strong>'+(lot.current_bid!=null?'$'+Number(lot.current_bid).toLocaleString('en-US'):'Немає даних')+'</strong></div><div><small>Buy Now</small><strong>'+(lot.buy_now!=null?'$'+Number(lot.buy_now).toLocaleString('en-US'):'Немає даних')+'</strong></div></div><dl><div><dt>Паливо</dt><dd>'+esc(vehicle.fuel||'—')+'</dd></div><div><dt>Привід</dt><dd>'+esc(vehicle.drive||'—')+'</dd></div><div><dt>Кузов</dt><dd>'+esc(vehicle.body||'—')+'</dd></div><div><dt>Локація</dt><dd>'+esc(lot.location||vehicle.location||'—')+'</dd></div><div><dt>Дата аукціону</dt><dd>'+esc(lot.auction_date||vehicle.auction_date||'—')+'</dd></div><div><dt>VIN</dt><dd>'+esc(vin)+'</dd></div></dl><div class="vin-result-source">Cars24 Vehicle Graph. Дані показуються тільки там, де вони є у джерелах.</div></div></div>'}catch{out.innerHTML='<div class="vin-result-empty is-error"><strong>Не вдалося отримати VIN</strong><p>Спробуйте ще раз.</p></div>'}}form.addEventListener('submit',e=>{e.preventDefault();run(input.value,true)});const vin=new URLSearchParams(location.search).get('vin');if(vin)run(vin,false)});</script></WpLayout>
