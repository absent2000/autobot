---
import WpLayout from '../../layouts/WpLayout.astro';import {API,u} from '../../lib/cars24';const vin=(Astro.url.searchParams.get('vin')||'').trim().toUpperCase();let v:any=null;if(vin.length===17){try{const r=await fetch(`${API}/vin?vin=${encodeURIComponent(vin)}`);if(r.ok)v=await r.json()}catch{}}const vehicle=v?.vehicle||null;const photo=(v?.photos||[])[0];
---
<WpLayout title="Перевірка VIN — Cars24"><main class="vin-check-page"><div class="c24-shell vin-check-topline"><span>CARS24 · VEHICLE GRAPH</span><a href={u('/home-lab/')}>← До підбору за бюджетом</a></div><section class="vin-check-hero c24-shell"><div class="vin-check-copy"><span class="vin-check-kicker">VIN / LOT / ІСТОРІЯ</span><h1>Один VIN.<br>Одна історія автомобіля.</h1><p>Шукаємо автомобіль у даних Cars24 і не змішуємо різні сутності: VIN, аукціонний lot, спостереження джерел та події зберігаються окремо.</p><form class="vin-check-form"><label>VIN-код</label><div class="vin-check-inputrow"><input name="vin" value={vin} maxlength="17" placeholder="5YJ3E1EBXKF214092"><button>Перевірити</button></div><small>17 символів. Без пробілів. Літери I, O та Q у VIN не використовуються.</small></form><div class="vin-check-demo"><span>Спробувати приклад:</span><a href={u('/vin/?vin=5YJ3E1EBXKF214092')}>Tesla Model 3</a><a href={u('/vin/?vin=SMTD51HG4KT941934')}>Triumph Scrambler 1200 XE</a></div></div><aside class="vin-check-side"><span class="vin-check-side-kicker">ЩО ЗБИРАЄ CARS24</span><strong>Від сирого лота до зрозумілої хронології</strong><div><span>01</span><p><b>Ідентичність</b>VIN, марка, модель, рік і конфігурація.</p></div><div><span>02</span><p><b>Аукціони</b>Copart / IAAI, lot ID, дати, статуси та ціни.</p></div><div><span>03</span><p><b>Стан</b>Пошкодження, пробіг, ключі, Run & Drive і фото.</p></div><div><span>04</span><p><b>Економіка</b>LotScan, Max Bid, landed cost і ринок України.</p></div></aside></section>{vin&&vin.length!==17?<section class="vin-result c24-shell"><div class="vin-result-empty is-error"><strong>VIN має містити 17 символів</strong></div></section>:vehicle?<section class="vin-result c24-shell"><div class="vin-result-head"><div><span>{String(vehicle.vehicle_type||'').toUpperCase()}</span><h2>{vehicle.year||vehicle.model_year} {vehicle.make} {vehicle.model}</h2><p>{vin}</p></div><a href={u('/vehicle-card-shadow/?vin='+vin)}>Відкрити картку →</a></div><div class="vin-result-grid"><div class="vin-result-visual">{photo?<img src={photo.url||photo} alt={vin}/>:<div class="vin-photo-empty">Фото поки не прив’язане</div>}</div><div class="vin-result-data"><dl><div><dt>Марка</dt><dd>{vehicle.make||'—'}</dd></div><div><dt>Модель</dt><dd>{vehicle.model||'—'}</dd></div><div><dt>Рік</dt><dd>{vehicle.year||vehicle.model_year||'—'}</dd></div><div><dt>VIN</dt><dd>{vin}</dd></div></dl></div></div></section>:vin?<section class="vin-result c24-shell"><div class="vin-result-empty"><span>VIN {vin}</span><strong>Цього VIN поки немає в Vehicle Graph</strong></div></section>:null}</main></WpLayout>
