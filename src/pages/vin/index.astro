---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VinPassport from '../../components/VinPassport';
---
<BaseLayout title="VIN-паспорт Cars24" description="Безкоштовна розшифровка VIN: NHTSA, Vehicle Graph Cars24, фото, аукціонні та ринкові спостереження.">
  <main class="vinPage">
    <div class="shell vinTop"><span>CARS24 · VEHICLE GRAPH</span><a href="/#budget">← До підбору за бюджетом</a></div>
    <section class="vinHero shell">
      <div class="vinCopy"><span class="vinKicker">VIN / LOT / ІСТОРІЯ</span><h1>Один VIN.<br/>Одна історія автомобіля.</h1><p>Офіційна розшифровка NHTSA поєднується з тим, що Cars24 уже знає про конкретну машину: джерела, фото, аукціонні лоти, ринкові оголошення та історичні розрахункові орієнтири.</p><div class="vinHint"><b>Введіть VIN нижче</b><span>17 символів · без I, O та Q</span></div></div>
      <aside class="vinSide"><span>ЩО ЗБИРАЄ CARS24</span><strong>Від сирого лота до зрозумілої хронології</strong><div><i>01</i><p><b>Ідентичність</b>VIN, марка, модель, рік і конфігурація.</p></div><div><i>02</i><p><b>Аукціони</b>Copart / IAAI, lot ID, дати, статуси та ціни.</p></div><div><i>03</i><p><b>Стан</b>Пошкодження, пробіг, фото та спостереження джерел.</p></div><div><i>04</i><p><b>Економіка</b>Cars24 reference, а далі Max Bid і landed cost.</p></div></aside>
    </section>
    <section class="shell vinTool"><VinPassport client:load /></section>
  </main>
</BaseLayout>
<style>
.vinPage{background:#f4f6f8;min-height:70vh;padding:28px 0 90px}.vinTop{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px;font-size:11px;font-weight:850;letter-spacing:.08em;color:#7d8790}.vinTop a{color:#111820;letter-spacing:0}.vinHero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.65fr);gap:24px}.vinCopy,.vinSide{background:#fff;border-radius:24px}.vinCopy{padding:54px}.vinKicker{display:inline-block;background:#111820;color:#fff;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:850;letter-spacing:.08em}.vinCopy h1{font-family:'Barlow Condensed',sans-serif;font-size:64px;line-height:.92;letter-spacing:-.035em;max-width:800px;margin:24px 0 16px}.vinCopy>p{font-size:17px;line-height:1.65;color:#66717c;max-width:760px;margin:0}.vinHint{margin-top:30px;background:#f5f7f9;border-radius:16px;padding:17px 19px;display:flex;justify-content:space-between;gap:15px;align-items:center}.vinHint span{color:#7b858d;font-size:12px}.vinSide{padding:34px}.vinSide>span{display:block;font-size:10px;font-weight:900;letter-spacing:.1em;color:#a17e00;margin-bottom:8px}.vinSide>strong{display:block;font-size:23px;margin-bottom:18px}.vinSide>div{display:grid;grid-template-columns:42px 1fr;gap:12px;padding:19px 0;border-top:1px solid #e5e8eb}.vinSide i{width:38px;height:38px;border-radius:10px;background:#ffd000;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;font-style:normal}.vinSide p{margin:0;color:#6d7780;font-size:12px;line-height:1.5}.vinSide b{display:block;color:#111820;font-size:14px;margin-bottom:3px}.vinTool{margin-top:24px;background:#fff;border-radius:22px;padding:30px}@media(max-width:900px){.vinHero{grid-template-columns:1fr}.vinCopy{padding:30px}.vinCopy h1{font-size:48px}.vinSide{padding:26px}}@media(max-width:560px){.vinPage{padding-top:18px}.vinTop{align-items:flex-start;flex-direction:column}.vinCopy,.vinSide,.vinTool{border-radius:18px}.vinCopy{padding:22px}.vinCopy h1{font-size:38px}.vinHint{display:grid}.vinTool{padding:16px}}
</style>
