---
import WpLayout from '../../layouts/WpLayout.astro';import {u} from '../../lib/cars24';const photos=[1,2,3,4,5].map(i=>`https://cars24.com.ua/wp-content/uploads/2026/09/Tesla-Model-3-5YJ3E1EBXKF214092-—-0${i}.jpg`);
---
<WpLayout title="Vehicle Card — Shadow UI"><main class="vehicle-shadow-page" data-vehicle-type="automobile"><section class="vehicle-shadow-shell c24-shell"><div class="vehicle-breadcrumbs">Головна <span>›</span> Авто <span>›</span> Tesla <span>›</span> Model 3 <span>›</span> Лот 53848596</div><div class="vehicle-shadow-hero"><section class="c24v2-gallery" data-c24-gallery><div class="c24v2-photo"><img data-c24-gallery-main src={photos[0]} alt="2019 Tesla Model 3"/><span class="vehicle-shadow-source">Copart</span><button class="vehicle-photo-arrow left" type="button" data-c24-prev>‹</button><button class="vehicle-photo-arrow right" type="button" data-c24-next>›</button><span class="vehicle-photo-count"><span data-c24-current>1</span> / {photos.length}</span></div><div class="c24v2-thumbs">{photos.map((p,i)=><button type="button" class={i===0?'is-active':''} data-c24-thumb data-index={i} data-src={p}><img src={p} alt=""/></button>)}</div></section><aside class="vehicle-shadow-side"><section class="shadow-card vehicle-shadow-offer"><div class="vehicle-shadow-id"><span>Lot #53848596</span><span>VIN: 5YJ3E1EBXKF214092</span></div><h1>2019 Tesla Model 3</h1><p>AWD · Automatic</p><div class="vehicle-shadow-auctionline"><strong>Copart</strong><span>AZ — Phoenix North</span><span>10.09.2026</span></div><div class="vehicle-shadow-prices"><div><small>Ціна на аукціоні</small><strong>$5,800</strong><span>Ставка / ціна лота</span></div><div><small>Орієнтовна вартість в Україні</small><strong class="green">Розрахуємо</strong><span>Авто, збори, доставка та оформлення</span></div></div><div class="vehicle-yellow-action"><strong>Точний розрахунок до покупки</strong><span>Порахуємо повну вартість цього або схожого лота в Україні.</span><a class="vehicle-shadow-cta" href="https://t.me/Egor_Cars24">Розрахувати точну вартість</a></div><div class="vehicle-shadow-benefits"><span>Фіксована комісія $500</span><span>Доставка під ключ</span><span>Допомога з ремонтом</span></div></section><section class="shadow-card vehicle-shadow-time"><div><small>Статус аукціону</small><strong>Завершено</strong></div><div><small>Дата аукціону</small><strong>10.09.2026</strong></div></section></aside></div><section class="shadow-card vehicle-shadow-specs"><div><small>Пробіг</small><strong>70,676 mi</strong></div><div><small>Паливо</small><strong>Electric</strong></div><div><small>Коробка</small><strong>Automatic</strong></div><div><small>Привід</small><strong>AWD</strong></div><div><small>Кузов</small><strong>Sedan</strong></div><div><small>Колір</small><strong>Blue</strong></div></section><div class="vehicle-shadow-grid"><section class="shadow-card"><h2>Vehicle Graph</h2><dl><div><dt>Schema</dt><dd>v1</dd></div><div><dt>Тип сутності</dt><dd>automobile</dd></div><div><dt>Auction events</dt><dd>1</dd></div><div><dt>Market listings</dt><dd>0</dd></div><div><dt>Evidence</dt><dd>1</dd></div><div><dt>Індексація</dt><dd>noindex до достатніх доказів</dd></div></dl></section><section class="shadow-card"><h2>Основна інформація</h2><dl><div><dt>Рік</dt><dd>2019</dd></div><div><dt>Марка</dt><dd>Tesla</dd></div><div><dt>Модель</dt><dd>Model 3</dd></div><div><dt>VIN</dt><dd>5YJ3E1EBXKF214092</dd></div><div><dt>Lot ID</dt><dd>53848596</dd></div><div><dt>Кузов</dt><dd>Sedan</dd></div><div><dt>Колір</dt><dd>Blue</dd></div><div><dt>Паливо</dt><dd>Electric</dd></div><div><dt>Коробка</dt><dd>Automatic</dd></div><div><dt>Привід</dt><dd>AWD</dd></div></dl></section><section class="shadow-card"><h2>Стан та пошкодження</h2><dl><div><dt>Статус</dt><dd>—</dd></div><div><dt>Ключі</dt><dd>Є</dd></div><div><dt>Основне пошкодження</dt><dd>Front End</dd></div><div><dt>Додаткові пошкодження</dt><dd>Minor Dent / Scratches</dd></div><div><dt>Документи</dt><dd>AZ Salvage</dd></div></dl></section><section class="shadow-card"><h2>Інформація про аукціон</h2><dl><div><dt>Аукціон</dt><dd>Copart</dd></div><div><dt>Lot ID</dt><dd>53848596</dd></div><div><dt>Локація</dt><dd>Phoenix North</dd></div><div><dt>Штат</dt><dd>AZ</dd></div><div><dt>Дата аукціону</dt><dd>10.09.2026</dd></div><div><dt>Джерело</dt><dd>Cars24</dd></div></dl><div class="vehicle-shadow-lead"><strong>Потрібна допомога з цим авто?</strong><span>Перевіримо лот та розрахуємо повну вартість доставки в Україну.</span><a href="https://t.me/Egor_Cars24">Отримати консультацію</a></div></section></div></section><script is:inline>document.addEventListener('DOMContentLoaded',()=>{const g=document.querySelector('[data-c24-gallery]');if(!g)return;const main=g.querySelector('[data-c24-gallery-main]'),thumbs=[...g.querySelectorAll('[data-c24-thumb]')],cur=g.querySelector('[data-c24-current]');let i=0;const show=n=>{i=(n+thumbs.length)%thumbs.length;main.src=thumbs[i].dataset.src;cur.textContent=String(i+1);thumbs.forEach((t,x)=>t.classList.toggle('is-active',x===i))};thumbs.forEach((t,x)=>t.addEventListener('click',()=>show(x)));g.querySelector('[data-c24-prev]')?.addEventListener('click',()=>show(i-1));g.querySelector('[data-c24-next]')?.addEventListener('click',()=>show(i+1))});</script></main></WpLayout>
