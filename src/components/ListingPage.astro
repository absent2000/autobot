---
import {u,years} from '../lib/cars24';
const {items=[],title='Каталог Cars24',eyebrow='CARS24'}=Astro.props;
---
<main class="c24-catalog c24-v16-listing"><section class="c24-catalog-hero"><div class="c24-shell"><div><span class="c24-v16-hero-kicker">{eyebrow}</span><h1>{title}</h1><p>{items.length} моделей у whitelist Cars24</p></div></div></section><section class="c24-catalog-main"><div class="c24-shell"><div class="c24-v16-toolbar"><a href={u('/catalog/')}>← Увесь каталог</a><input id="c24-v16-filter" placeholder="Фільтр моделей…"></div><div class="c24-v16-catalog-grid" id="c24-v16-grid">{items.map((r:any)=><article class="c24-v16-model-card" data-search={`${r.make_name} ${r.model_name}`.toLowerCase()}><a class="c24-v16-model-photo" href={u(`/${r.vehicle_type==='moto'?'moto':'cars'}/${r.make_slug}/${r.model_slug}/`)}><img src={r.image_url||'https://cars24.com.ua/wp-content/uploads/2026/09/BMW-X5-2021-auction-demo.jpg'} alt={`${r.make_name} ${r.model_name}`}><span>{r.class_name||r.body_class||''}</span></a><div><small>{years(r)}</small><h2><a href={u(`/${r.vehicle_type==='moto'?'moto':'cars'}/${r.make_slug}/${r.model_slug}/`)}>{r.make_name} {r.model_name}</a></h2><p>Сторінка моделі Cars24.</p><div class="c24-v16-card-actions"><a href={u(`/${r.vehicle_type==='moto'?'moto':'cars'}/${r.make_slug}/${r.model_slug}/`)}>Модель</a><a href={u(`/auction-search-guazi/?type=${r.vehicle_type}&make=${encodeURIComponent(r.make_name)}&q=${encodeURIComponent(r.model_name)}`)}>Аукціони</a></div></div></article>)}</div></div></section></main><script is:inline>document.addEventListener('DOMContentLoaded',()=>{const q=document.getElementById('c24-v16-filter'),cards=[...document.querySelectorAll('[data-search]')];q?.addEventListener('input',()=>{const s=q.value.toLowerCase().trim();cards.forEach(c=>c.hidden=!!(s&&!c.dataset.search.includes(s)))})});</script>
